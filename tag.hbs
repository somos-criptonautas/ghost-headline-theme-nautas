{{!< default}}
{{#tag}}
<div class="archive-section{{#if feature_image}} is-image{{/if}}">
<span class="center">	{{#if feature_image}}
	<div class="archive-image global-image">
		<a href="{{url}}" class="global-link" aria-label="#{{name}}"></a>
		{{>images/other_image other_image=feature_image alt=name}}
	</div>
	{{/if}}
	<h1 class="archive-title global-title is-tag gh-topic-link">{{> "channel-icon" slug=slug}}{{ name }}<span>{{../pagination.total}}</span></h1>
	{{#if description}}
	<p class="archive-excerpt global-excerpt">{{description}}</p>
	{{/if}}
	</span>
</div>
{{/tag}}
<div class="gh-with-sidebar global-padding">
	<div class="gh-with-sidebar-main">
		{{>loop}}
	</div>
	{{> "community-sidebar" category=tag.slug}}
</div>
<a class="gh-article-tag " href="/tags">+ TAGs</a>
