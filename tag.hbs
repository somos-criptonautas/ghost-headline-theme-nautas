{{!< default}}
{{#tag}}
<div class="archive-section{{#if feature_image}} is-image{{/if}}">
<span class="center">	{{#if feature_image}}
	<div class="archive-image global-image">
		<a href="{{url}}" class="global-link" aria-label="#{{name}}"></a>
		{{>images/other_image other_image=feature_image alt=name}}
	</div>
	{{/if}}
	<h1 class="archive-title global-title is-tag gh-topic-link">{{> "channel-icon" slug=slug}}{{ name }}<span>{{../pagination.total}}</span></h1>
	{{#if description}}
	<p class="archive-excerpt global-excerpt">{{description}}</p>
	{{/if}}
	</span>
</div>
{{/tag}}
{{!-- The same cards as /blog (loop-grid: padding, excerpt, channel and
    level), then the tag's forum topics after the first page's last post, the
    block under an article. Later pages load in after it (infinite scroll). --}}
<main class="gh-main gh-outer">
	<div class="gh-inner">
	<div class="gh-topic gh-topic-grid gh-topic-grid-item gh-listing">
		<div class="gh-topic-content gh-feed">
			{{#foreach posts}}
			{{> "loop-grid" has_large_post=false}}
			{{!-- The channel's videos after the sixth post, or after the last with fewer. --}}
			{{^is "paged"}}{{#has number="6"}}{{> "channel-videos" category=../tag.slug}}{{else}}{{#if @last}}{{#has number="1,2,3,4,5"}}{{> "channel-videos" category=../tag.slug}}{{/has}}{{/if}}{{/has}}{{/is}}
			{{^is "paged"}}{{#if @last}}{{> "community-related" category=../tag.slug}}{{/if}}{{/is}}
			{{/foreach}}
		</div>
		{{#if pagination.next}}
		<footer class="gh-topic-footer">
			<a class="gh-topic-link gh-loadmore" href="{{page_url pagination.next}}">{{t "Show more"}} {{> "icons/arrow"}}</a>
		</footer>
		{{/if}}
	</div>
	</div>
</main>
<a class="gh-article-tag" href="/tags">{{t "more channels"}}</a>
