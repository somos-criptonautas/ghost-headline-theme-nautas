{{!< default}}
{{!-- "Videos" page template. Create a page in Ghost Admin (e.g. /videos/),
    pick this template, and add it to the navigation. The page's own title,
    excerpt and content show above the videos, which come from the
    "Peertube source" theme setting - see partials/peertube-videos.hbs. --}}
<main class="gh-main">
{{#post}}
    <article class="gh-article {{post_class}}">
        <header class="gh-article-header gh-canvas">
            <h1 class="gh-article-title">{{title}}</h1>
            {{#if custom_excerpt}}
            <p class="gh-article-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </header>

        {{#if html}}
        <section class="gh-content gh-canvas">
            {{content}}
        </section>
        {{/if}}
    </article>
{{/post}}

    <div class="gh-outer gh-videos-page">
        <div class="gh-inner">
            {{> "peertube-videos"}}
        </div>
    </div>
</main>
