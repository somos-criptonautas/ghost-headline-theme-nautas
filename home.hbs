{{!< default}}
{{!-- The home (/): the landing, then Destacado and the community - the strip
    after the featured posts below 1200px, the aside beside them from 1200px.
    Every post, newest first and scrolling on, is /blog/ (index.hbs). --}}
<main class="gh-main gh-outer">
    <div class="gh-inner">
    {{> "landing"}}
    <div class="gh-with-sidebar">
        <div class="gh-with-sidebar-main">
        {{> "featured"}}
        {{> "community-related" strip=true}}
        </div>
        {{> "community-sidebar"}}
    </div>
    </div>
</main>
