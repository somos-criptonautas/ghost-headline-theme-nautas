{{!< default}} <main class="gh-main gh-outer">
    {{!-- <div class="kg-card kg-callout-card kg-callout-card-grey beta-box">
        <div class="kg-callout-emoji">🪐</div>
        <div class="kg-callout-text m-auto"><a href=/sumar>We are in beta, you should expect bugs</a></div>
    </div> --}}
    {{!-- Homepage order: Trending and the tag sections beside the community
        sidebar. Videos have their own page (custom-videos.hbs). Trending is a fixed 4
        with no infinite scroll here - it used to load every page of posts as
        you reached it, pushing whatever came after it out of reach. /blog/
        and /page/2/ onward keep infinite scroll.

        .gh-with-sidebar puts the community aside next to the sections from
        1200px up and after them below that. It was a <divgh-> typo before,
        an unknown inline element, so .gh-inner never limited the width. --}}
    <div class="gh-inner">
    <div class="gh-with-sidebar">
        <div class="gh-with-sidebar-main">
        <section class="gh-topic gh-topic-grid">
            <h2 class="gh-topic-name">
                {{#match pagination.total ">" 4}}
                <a href="{{@site.url}}/blog/">{{ t "Featured" }}</a>
                {{else}}
                {{t "Featured" }}
                {{/match}}
            </h2>

            <div class="gh-topic-content">
                {{#foreach posts limit="4"}}
                {{> "loop-grid"}}
                {{/foreach}}
            </div>

        </section>

        {{!-- Tag sections. The first three show; up to nine more are
            rendered hidden and assets/js/home-topics.js reveals three per
            click of "+ More articles". Without JS, or once all are out, the
            button gives way to "View all", to /blog/. --}}
        <div class="gh-topics">
            {{#if @custom.enter_tag_slugs_for_primary_sections}}
            {{#get "tags" filter="slug:[{{@custom.enter_tag_slugs_for_primary_sections}}]"}}
            {{#foreach tags}}
            {{> "topic-grid"}}
            {{/foreach}}
            {{/get}}
            {{#get "tags" filter="visibility:public+slug:-[{{@custom.enter_tag_slugs_for_primary_sections}}]" include="count.posts" order="count.posts desc" limit="9"}}
            {{#foreach tags}}
            {{#if count.posts}}
            <div class="gh-topics-more" hidden>{{> "topic-grid"}}</div>
            {{/if}}
            {{/foreach}}
            {{/get}}
            {{else}}
            {{#get "tags" filter="visibility:public" include="count.posts" order="count.posts desc" limit="12"}}
            {{#foreach tags limit="3"}}
            {{> "topic-grid"}}
            {{/foreach}}
            {{#foreach tags from="4"}}
            {{#if count.posts}}
            <div class="gh-topics-more" hidden>{{> "topic-grid"}}</div>
            {{/if}}
            {{/foreach}}
            {{/get}}
            {{/if}}

            <footer class="gh-topic-footer gh-topics-footer">
                <button class="gh-topic-link gh-topics-button" type="button" hidden>+ {{t "More articles"}}</button>
                <a class="gh-topic-link gh-topics-all" href="{{@site.url}}/blog/">{{t "View all"}} {{> "icons/arrow"}}</a>
            </footer>
        </div>

        {{!-- The small tag list only when it is set: its old default (tags
            4-6) is now the first batch behind "+ More articles". --}}
        {{#if @custom.enter_tag_slugs_for_secondary_sections}}
        {{#get "tags" filter="slug:[{{@custom.enter_tag_slugs_for_secondary_sections}}]"}}
        {{#if tags}}
        <div class="gh-topic-list">
            {{#foreach tags}}
            {{> "topic-minimal"}}
            {{/foreach}}
        </div>
        {{/if}}
        {{/get}}
        {{/if}}
        </div>

        {{> "community-sidebar"}}
    </div>
    </div>
</main>
