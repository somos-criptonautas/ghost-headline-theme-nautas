<!DOCTYPE html>
<html lang="{{@site.locale}}">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="HandheldFriendly" content="True" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    
        <title>{{ t "Continue to your account" }}</title>
        
        <script>
    
            if(typeof(Storage) !== 'undefined') {
                if (localStorage.getItem('selected-theme') == 'light') {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
                else if (localStorage.getItem('selected-theme') == 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            }

        </script>
        {{ghost_head}}
        {{!-- Outputs SEO meta+structured data and important settings, should always be in <head> --}}
    </head>

<body class="{{body_class}}">



{{#if @member.paid}}
    {{!-- Logged in: Redirect home --}}
    <script>window.location = '{{@site.url}}';</script>
{{else if @member}}
    {{!-- Member: Redirect to Subscribe --}}
    <script>window.location = '{{@site.url}}/nauta/';</script>
{{else}}


<!-- subscribe section start from here    -->
<div class="subscribe-section">
    {{#post}}
            <div class="custom-no-feature-sign">
            <div class="cus-sign-box">
                    <header class="mainhead">
                    <a class="home-link" href="{{@site.url}}">
        <img class="logo-nav logo-light lazy" src="{{#if @site.logo}}{{@site.logo}}{{else}}{{asset "images/brand/criptonautas-horizontal-color.svg"}}{{/if}}" alt="{{@site.title}}">
        <img class="logo-nav logo-dark lazy" src="{{#if @custom.dark_logo}}{{@custom.dark_logo}}{{else}}{{asset "images/brand/criptonautas-horizontal-oscuro.svg"}}{{/if}}" alt="{{@site.title}}">
                    </a>
                </header>
                <div class="form-inner-content">
                    <form data-members-form="signin">
                                                            <div class="subscribe-title">
                    <p>{{ t "Continue to your account" }}</p>
                </div>
                                                <div class="message-text">
                            <div class="message-success">
                                {{t "Check your inbox"}}
                            </div>
                            <div class="message-error">
                                {{t "Please enter a valid email address!"}}<br><br>
                                <a class="start-here" href="{{@site.url}}/start">{{ t "Follow the link"}}</a>
                            </div>
                        </div>
                        <div>
                            <div class="single-input mb-20">
                                <input data-members-email class="form-control" type="email" required placeholder="{{t "Email"}}">
                            </div></div>
                            <div class="subscribe-btn d-flex align-items-center">
                                <button  type="submit" class="btn btn-sign">
                                    <span class="button-text">{{t "Send login link"}}</span>
                                    <span class="button-loader">{{> "icons/loader"}}</span>
                                </button>
                            </div>
                        <p>{{t "Don't have an account yet?"}}<br><a href="{{@site.url}}/start/">&nbsp;{{t "Sign up"}}</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {{/post}}
</div>
{{/if}}
<!-- // subscribe section end from here   -->


{{!-- Jquery scripts --}}
{{!-- {{> "membership/notifications"}} --}}
{{> "site-structure/site-scripts"}} 
{{{block "scripts"}}}

{{!-- ghost footer --}}
{{ghost_foot}}

</body>
</html>

