<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    <!-- prettier-ignore-start -->
    <link rel="stylesheet" href="{{asset "built/screen.css"}}">
    <!-- prettier-ignore-end -->
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
    <link rel="stylesheet" href="https://fonts.bunny.net/css2?family=Outfit:wght@400;500;600;700;800&display=swap">
    <link href="{{@site.url}}/continue" rel="prefetch">
    <link href="{{@site.url}}/start" rel="prefetch">
    <link rel="preconnect" href="https://comunidad.criptonautas.co">
    <script
        src='https://pay.criptonautas.co/plugins/Ftaic9XyP8AYSuMKrU2bxw7PrAn9DZjyJKGY62BXThy1/ghost/public/paywall/btcpay-ghost-paywall.js'></script>
    <!-- Blocking on purpose: sets the theme before first paint. External
         rather than inline because the CSP allowlists script hashes, which
         disables 'unsafe-inline' and would block any edited inline script. -->
    <script src="{{asset "js/theme.js"}}"></script>
    {{#if @member}}
    {{else}}
    {{#is "home"}}
    {{> "newsletter"}}
    <link rel="stylesheet" href="{{asset "built/home.css"}}">
    {{/is}}
    {{/if}}
    {{!-- Webmention receiving endpoint. {{ghost_head}} emits Ghost's own
        (/webmentions/receive/), but Ghost exposes received mentions on the
        Admin API only, so a theme cannot render them - webmentions.js reads
        webmention.io instead. Declared before {{ghost_head}} on purpose: the
        Webmention spec resolves to the first <link> in document order.

        Long comment form: {{! }} ends at the first }}, so the {{ghost_head}}
        above would have closed it early and leaked the rest into the page. --}}
    <link rel="webmention" href="https://webmention.io/criptonautas.co/webmention">
    {{! IndieAuth identity for signing in to webmention.io. A personal profile,
        not the org: IndieLogin authenticates a GitHub *user* and compares that
        user's profile URL against this one, and an org can neither be
        authenticated as nor carry a link back. That profile's website field
        must be this site for the pair to verify. }}
    <link rel="me" href="https://github.com/satonotdead">
    {{! Portal is not used on this site. Excluding it stops Ghost injecting
        the members script; the exclude list is Ghost's supported switch. }}
    {{ghost_head exclude="portal"}}

</head>

<body class="{{body_class}}{{{block "body_class"}}} {{#if
    @site.description}}is-head-b--a_n{{else}}is-head-b--n--a{{/if}}{{#is "tag" }}{{/is}}">
    <div class="gh-site">
        <header id="gh-head" class="gh-head gh-outer">
            <div class="gh-head-inner gh-inner">
                <div class="gh-head-brand">
                    <div class="gh-head-brand-wrapper">
                        {{^is "home"}}<a class="gh-head-logo" href="{{@site.url}}">{{else}}<span
                                class="gh-head-logo">{{/is}}
                                {{#if @site.logo}}
                                <img class="logo-nav logo-light" src="{{@site.logo}}" alt="{{@site.title}}">
                                {{! Alternate logo: dark mode and the transparent
                                    header over a cover image. Its image comes
                                    from Design -> Site-wide settings, not from
                                    this repo, so it resets to empty whenever the
                                    active theme id changes. }}
                                <img class="logo-nav logo-dark"
                                    src="{{@custom.white_publication_logo_for_transparent_header}}"
                                    alt="{{@site.title}}">
                                {{else}}
                                {{@site.title}}
                                {{/if}}
                                {{^is "home"}}</a>{{else}}</span>{{/is}}
                        {{#is "home"}}</h1>{{/is}}
                    </div>
                </div>
                <button id="gh-burger" class="gh-burger" aria-label="burger-menu"></button>
                <nav class="gh-head-menu">
                    {{navigation}}
                </nav>
                <div class="gh-head-actions">
                    <div class="actions-container">
                        {{#unless @member}}
                        <a aria-label="signup-button" title="start here" class="gh-head-btn gh-btn shadow"
                            href="{{@site.url}}/start">{{ t "Subscribe" }}</a>
                        {{else}}
                        <a aria-label="signin-button" title="your profile" class="gh-head-btn gh-btn shadow d-none"
                            href="{{@site.url}}/nauta">{{ t "Account" }}</a>
                        {{/unless}}
                        <div class="nav-icons">
                            <button class="gh-search gh-icon-btn" data-ghost-search>{{> "icons/search"}}</button>
                            <button type="button" class="it-dark-light gh-icon-btn" aria-label="{{t "Toggle theme"}}">
                                <div class="icon-dark">
                                    {{> icons/light}}
                                </div>
                                <div class="icon-light">
                                    {{> icons/dark}}
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    </div>
    {{{body}}}
    {{^is "page"}}
    <footer class="gh-foot global-padding">
        <div class="gh-foot-inner gh-inner">

            {{#get 'posts'}}
            {{#foreach posts visibility='all'}}
            {{/foreach}}
            {{/get}}
            {{#unless @member}}
            <section class="d-none">
                <h4 class="gh-subscribe-title">{{ t "Subscribe to" }}</h3>
                    <div class="gh-subscribe-description">{{ t "Newsletter description"}}</div>

                    <a class="gh-subscribe-btn gh-btn" href="{{@site.url}}/start">{{ t "Subscribe now" }}</a>

            </section>
            {{/unless}}
        </div>
    </footer>
    {{/is}}
    <div class="footer-criptonauta global-padding">
        <nav class="gh-foot-menu">
            {{navigation type="secondary"}}
        </nav>
        <div class="it-foot-social">
            <a href="https://github.com/somos-criptonautas/" class="github" title="{{t "Github"}}" target="_blank"
                rel="noopener" aria-label="{{t "Github"}}">{{> "icons/github"}}</a>
            <a href="{{@site.url}}/rss/" class="rss" title="{{t "RSS"}}" target="_blank" rel="noopener"
                aria-label="{{t "RSS"}}">{{> "icons/rss"}}</a>
        </div>
        <span class="no-estamos">(no estamos en Discord)</span>
        <div class="gh-copyright">
            <p>Criptonautas&nbsp;{{ t "is licensed under" }}<br>{{ t "from 🪐" }} <a href="https://satonotdead.co"
                    title="satonotdead's lab" target="_blank" rel="noopener">satonotdead</a></p>
        </div>
    </div>
    </div>
    {{#is "post, page"}}
    {{> "pswp"}}
    {{/is}}

    {{> "site-structure/site-scripts"}}
    {{{block "scripts"}}}
    {{ghost_foot}}
</body>

</html>