<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#if @custom.discourse_url}} data-discourse="{{@custom.discourse_url}}"{{/if}}>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    <!-- prettier-ignore-start -->
    <link rel="stylesheet" href="{{asset "built/screen.css"}}">
    <!-- prettier-ignore-end -->
    <link href="{{@site.url}}/continue" rel="prefetch">
    <link href="{{@site.url}}/start" rel="prefetch">
    {{#if @custom.discourse_url}}
    <link rel="preconnect" href="{{@custom.discourse_url}}">
    {{#is "post"}}{{#if @custom.discourse_comments}}
    {{! Comments: start fetching embed.js with the page instead of waiting for
        main.min.js to inject it at the end of <body>. Same URL and no
        crossorigin attribute, so the injected <script> reuses this response. }}
    <link rel="preload" href="{{@custom.discourse_url}}/javascripts/embed.js" as="script">
    {{/if}}{{/is}}
    {{/if}}
    {{!-- This site's own integrations, all in one file: see the partial. --}}
    {{> "site-integrations" place="head"}}
    <!-- Blocking on purpose: sets the theme before first paint. External
         rather than inline because the CSP allowlists script hashes, which
         disables 'unsafe-inline' and would block any edited inline script. -->
    <script src="{{asset "js/theme.js"}}"></script>
    {{#if @member}}
    {{else}}
    {{#is "home"}}
    {{> "newsletter"}}
    <link rel="stylesheet" href="{{asset "built/home.css"}}">
    {{/is}}
    {{/if}}
    {{! Portal is not used on this site, and search is assets/js/search-modal.js,
        which owns [data-ghost-search] itself - Ghost's sodo-search tag was
        loading a file that 404s since the MagicPages build was dropped. The
        exclude list is Ghost's supported switch; it splits on "," with no
        trimming, so do not put a space after the comma. }}
    {{#if @custom.search_host}}{{ghost_head exclude="portal,search"}}{{else}}{{ghost_head exclude="portal"}}{{/if}}
    {{!-- Site icons. After {{ghost_head}} on purpose: it emits its own
        <link rel="icon"> from the publication icon, and browsers use the last
        one declared. Ghost only serves theme files under assets/, hence
        assets/favicon/. The root /favicon.ico that browsers request unprompted
        is still Ghost's publication icon - set the same image there.

        - favicon.ico holds 16 and 32px; the 32px PNG is for browsers that
          prefer PNG
        - apple-touch-icon is 180px, the size iOS asks for
        - the manifest carries the 192 and 512px Android icons --}}
    <link rel="icon" href="{{asset "favicon/favicon.ico"}}" sizes="16x16 32x32">
    <link rel="icon" type="image/png" sizes="32x32" href="{{asset "favicon/favicon-32x32.png"}}">
    <link rel="apple-touch-icon" href="{{asset "favicon/apple-touch-icon.png"}}">
    <link rel="manifest" href="{{asset "favicon/site.webmanifest"}}">
    <meta name="theme-color" content="#F1F1F1" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#181719" media="(prefers-color-scheme: dark)">

</head>

<body class="{{body_class}}{{{block "body_class"}}} {{#if
    @site.description}}is-head-b--a_n{{else}}is-head-b--n--a{{/if}}{{#is "tag" }}{{/is}}">
    <div class="gh-site">
        <header id="gh-head" class="gh-head gh-outer">
            <div class="gh-head-inner gh-inner">
                <div class="gh-head-brand">
                    <div class="gh-head-brand-wrapper">
                        {{^is "home"}}<a class="gh-head-logo" href="{{@site.url}}">{{else}}<span
                                class="gh-head-logo">{{/is}}
                                {{!-- The logos uploaded in Ghost win: the publication logo, and
                                    the dark one from Design -> Site-wide -> Dark logo (a theme
                                    setting, so it empties whenever the active theme id changes).
                                    Without a dark one, the publication logo; without either, the
                                    site title. --}}
                                {{#if @site.logo}}
                                <img class="logo-nav logo-light" src="{{@site.logo}}" alt="{{@site.title}}">
                                <img class="logo-nav logo-dark" src="{{#if @custom.dark_logo}}{{@custom.dark_logo}}{{else}}{{@site.logo}}{{/if}}" alt="{{@site.title}}">
                                {{else}}
                                {{@site.title}}
                                {{/if}}
                                {{^is "home"}}</a>{{else}}</span>{{/is}}
                    </div>
                    {{!-- Tablet bar only: the site icon as the way back to the blog. --}}
                    {{#if @site.icon}}
                    <a class="gh-head-icon" href="{{@site.url}}" aria-label="{{@site.title}}">
                        <img src="{{@site.icon}}" alt="" width="32" height="32">
                    </a>
                    {{/if}}
                    {{!-- Tablet/mobile bar: logo | search | burger, sticky. The
                        theme toggle shows only with the menu open, under the ✕.
                        Desktop keeps search and theme in .gh-head-actions below;
                        CSS shows exactly one set at any width, and display:none
                        keeps the hidden one out of the accessibility tree.

                        A real input: assets/js/head.js hands what is typed to
                        the search modal, so there is still one search UI. --}}
                    <form class="gh-head-search-field" role="search">
                        {{> "icons/search"}}
                        <input type="search" name="s" placeholder="{{t "Search"}}" aria-label="{{t "Search this site"}}" autocomplete="off">
                    </form>
                    <button type="button" class="it-dark-light gh-icon-btn gh-head-bar-toggle" aria-label="{{t "Toggle theme"}}">
                        <div class="icon-dark">{{> icons/light}}</div>
                        <div class="icon-light">{{> icons/dark}}</div>
                    </button>
                    <button id="gh-burger" class="gh-burger" aria-label="{{t "Toggle menu"}}"></button>
                </div>
                {{!-- Desktop: a bar, like Discourse Horizon's, that opens the search
                    modal; centred from 1440px, where the logo shows (search.css). The
                    shortcut hint is set by assets/js/head.js. --}}
                <div class="gh-head-search">
                    <button type="button" class="gh-search gh-search-bar" data-ghost-search aria-label="{{t "Search this site"}}">
                        {{> "icons/search"}}
                        <span class="gh-search-bar-label">{{t "Search"}}</span>
                        <kbd class="gh-search-bar-key" hidden></kbd>
                    </button>
                </div>
                {{!-- Menu and theme toggle share the right-hand column on desktop; below
                    992px this wrapper steps aside (display: contents) for the mobile sheet. --}}
                <div class="gh-head-end">
                    <nav class="gh-head-menu">
                        {{navigation}}
                    </nav>
                    <div class="gh-head-actions">
                        <div class="actions-container">
                            <div class="nav-icons">
                                <button type="button" class="it-dark-light gh-icon-btn" aria-label="{{t "Toggle theme"}}">
                                    <div class="icon-dark">
                                        {{> icons/light}}
                                    </div>
                                    <div class="icon-light">
                                        {{> icons/dark}}
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                    {{!-- The footer's links, in the open menu below 992px, so they
                        are reachable without scrolling to the end. Hidden above. --}}
                    <div class="gh-head-more">
                        {{navigation type="secondary"}}
                        <div class="it-foot-social">
                            {{#if @custom.discourse_url}}
                            <a href="{{@custom.discourse_url}}" class="discourse" target="_blank" rel="noopener" aria-label="{{t "Community"}}">{{> "icons/discourse"}}</a>
                            {{/if}}
                            <a href="{{@site.url}}/rss/" class="rss" target="_blank" rel="noopener" aria-label="{{t "RSS"}}">{{> "icons/rss"}}</a>
                            {{#if @custom.github_url}}
                            <a href="{{@custom.github_url}}" class="github" target="_blank" rel="noopener" aria-label="{{t "Github"}}">{{> "icons/github"}}</a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </header>
    </div>
    {{{body}}}
    {{^is "page"}}
    <footer class="gh-foot global-padding">
        <div class="gh-foot-inner gh-inner">

            {{#get 'posts'}}
            {{#foreach posts visibility='all'}}
            {{/foreach}}
            {{/get}}
            {{#unless @member}}
            <section class="d-none">
                <h4 class="gh-subscribe-title">{{ t "Subscribe to" }}</h3>
                    <div class="gh-subscribe-description">{{ t "Newsletter description"}}</div>

                    <a class="gh-subscribe-btn gh-btn" href="{{@site.url}}/start">{{ t "Subscribe now" }}</a>

            </section>
            {{/unless}}
        </div>
    </footer>
    {{/is}}
    <div class="footer-criptonauta global-padding">
        <nav class="gh-foot-menu">
            {{navigation type="secondary"}}
        </nav>
        <div class="it-foot-social">
            {{#if @custom.discourse_url}}
            <a href="{{@custom.discourse_url}}" class="discourse" title="{{t "Community"}}" target="_blank"
                rel="noopener" aria-label="{{t "Community"}}">{{> "icons/discourse"}}</a>
            {{/if}}
            <a href="{{@site.url}}/rss/" class="rss" title="{{t "RSS"}}" target="_blank" rel="noopener"
                aria-label="{{t "RSS"}}">{{> "icons/rss"}}</a>
            {{#if @custom.github_url}}
            <a href="{{@custom.github_url}}" class="github" title="{{t "Github"}}" target="_blank"
                rel="noopener" aria-label="{{t "Github"}}">{{> "icons/github"}}</a>
            {{/if}}
        </div>
        {{#if @custom.footer_note}}<span class="no-estamos">{{@custom.footer_note}}</span>{{/if}}
        <div class="gh-copyright">
            <p>{{@site.title}}&nbsp;{{ t "is licensed under" }}<br>{{ t "from 🪐" }} <a href="https://satonotdead.co"
                    title="satonotdead's lab" target="_blank" rel="noopener">satonotdead</a></p>
        </div>
    </div>
    </div>

    {{#is "post, page"}}{{> "to-top"}}{{/is}}
    {{> "site-structure/site-scripts"}}
    {{{block "scripts"}}}
    {{ghost_foot}}
</body>

</html>