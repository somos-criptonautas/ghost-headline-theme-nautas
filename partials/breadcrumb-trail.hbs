{{!-- The breadcrumb itself (partials/breadcrumb.hbs). Params: name and link
    (the middle step), page_title and page_url (the last). --}}
<nav class="gh-article-tag" aria-label="{{t "Breadcrumb"}}">
    <a href="{{@site.url}}/">{{t "Blog"}}</a>
    <span aria-hidden="true">→</span>
    <a href="{{link}}">{{name}}</a>
</nav>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "{{t "Blog"}}", "item": "{{@site.url}}/"},
        {"@type": "ListItem", "position": 2, "name": "{{name}}", "item": "{{link}}"},
        {"@type": "ListItem", "position": 3, "name": "{{page_title}}", "item": "{{page_url}}"}
    ]
}
</script>
