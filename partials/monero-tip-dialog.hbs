{{!-- Monero tips (discourse-monero-tips) to the forum account in the
    "Monero tips username" setting. Any .gh-monero-tip-open on the page opens this;
    triggers carry data-monero-tip and stay hidden until the forum returns
    an address. Styled as the reactions dialog. Its words follow the
    browser's language, not the site's: assets/js/monero-tip.js fills each
    data-i18n. --}}
<dialog class="gh-reactions-dialog gh-monero-tip-dialog" data-username="{{@custom.monero_tips_username}}" aria-labelledby="gh-monero-tip-text">
    <p id="gh-monero-tip-text" data-i18n="intro"></p>
    <img class="gh-monero-tip-qr" alt="" data-i18n-alt="scan" width="240" height="240">
    <input class="gh-monero-tip-address" type="text" readonly data-i18n-aria="address">
    <div class="gh-monero-tip-actions">
        <button class="gh-reactions-close gh-monero-tip-copy" type="button" data-i18n="copy"></button>
        <a class="gh-reactions-close gh-monero-tip-wallet" data-i18n="wallet"></a>
    </div>
    <form method="dialog"><button class="gh-monero-tip-dismiss" data-i18n="close"></button></form>
</dialog>
