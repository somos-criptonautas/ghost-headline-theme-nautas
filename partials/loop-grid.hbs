<article class="gh-card {{post_class}}">
    <a class="gh-card-link" href="{{url}}">
        {{#if feature_image}}
        {{!-- The automatic cover (criptonautas-featured-ghost-cover, 1200x630) keeps its
            title and logo on the left: is-cover crops it from the right. --}}
        <figure class="gh-card-image{{#match feature_image "~" "/portada"}} is-cover{{/match}}{{#match feature_image "~" "/cover."}} is-cover{{/match}}">
            <img loading="lazy" srcset="{{img_url feature_image size="s" format="webp" }} 300w, {{img_url feature_image
                size="m" format="webp" }} 720w, {{img_url feature_image size="l" format="webp" }} 960w, {{img_url
                feature_image size="xl" format="webp" }} 1200w, {{img_url feature_image size="xxl" format="webp" }}
                2000w" sizes="(max-width: 1200px) 100vw, 1200px" src="{{img_url feature_image size="m" format="webp"
                }}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{!-- Tag pages: the channel is the page's own, so only the level,
                top right, as on an article's image. --}}
            {{#is "tag"}}{{> "level"}}{{else}}{{> "image-band"}}{{/is}}
        </figure>
        {{/if}}

        <div class="gh-card-wrapper">
            {{!-- Without an image, channel and difficulty sit above the title. --}}
            {{^if feature_image}}<div class="gh-card-marks">{{> "channel"}}{{> "level"}}</div>{{/if}}
            <header class="gh-card-header">
                <h1 class="gh-card-title"><span class="gh-card-mark">{{title}}</span></h1>
            </header>

            {{#if excerpt}}
            {{#is "home"}}
            {{#has index="0"}}
            <div class="gh-card-excerpt">{{excerpt}}</div>
            {{/has}}
            {{else}}
            <div class="gh-card-excerpt">{{excerpt}}</div>
            {{/is}}
            {{/if}}

            <footer class="gh-card-footer">
                <span class="gh-card-author">por {{#foreach authors}}{{#if @first}}{{name}}{{else}},
                    {{name}}{{/if}}{{/foreach}}</span>
                {{!-- The last update, not the first publication. --}}
                <time class="gh-card-date" datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at timeago="true"}}</time>
                {{comment_count class="gh-card-comments"}}
            </footer>
        </div>
    </a>
</article>