{{!-- Related posts: two blocks that grow from 4 to 8 on scroll, fetched as 9
    so the "Show more" link only appears when a ninth post exists. --}}
{{#is "post"}}
    {{#if post.primary_tag}}
        {{#get "posts" include="authors" filter="tag:{{post.primary_tag.slug}}+id:-{{post.id}}" limit="9" as |next|}}
            {{> "read-next" posts=next tag=post.primary_tag more_url=post.primary_tag.url}}
        {{/get}}

        {{#get "posts" include="authors" filter="tag:-{{post.primary_tag.slug}}+id:-{{post.id}}" limit="9" as |next|}}
            {{> "read-next" posts=next title=(t "Want more") more_url="/page/2/"}}
        {{/get}}
    {{else}}
        {{#get "posts" include="authors" filter="id:-{{post.id}}" limit="9" as |next|}}
            {{> "read-next" posts=next title=(t "Read next") more_url="/page/2/"}}
        {{/get}}
    {{/if}}
{{/is}}
