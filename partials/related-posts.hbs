{{!-- More articles: a grid of every other post (up to 24),
    ordered by meaning by assets/js/read-next.js from the search index's
    embeddings; newest first until then, or without it. --}}
{{#is "post"}}
    {{#get "posts" include="tags,authors" filter="id:-{{post.id}}" limit="24" as |next|}}
        {{> "read-next" posts=next similar_to=@root.post.id}}
    {{/get}}
{{/is}}
