<div class="loop-section global-padding">
	<div class="{{#is "tag,author"}}global-subtitle{{else if is_error}}global-subtitle{{else}}loop-subtitle{{/is}}">
		{{^if is_error}}
		{{^is "tag,author"}}
		{{#get "authors" limit="all" include="count.posts" order="count.posts desc"}}
		<div class="global-authors option{{#foreach authors}}{{#if count.posts}}{{#has number="1"}}-1{{else has number="2"}}-2{{else has number="6"}}-3{{/has}}{{/if}}{{/foreach}}">
			<div>
				{{#foreach authors to="5"}}
				{{#if count.posts}}
				<div class="global-item-author{{#if profile_image}} is-image global-image{{/if}}">
					<a href="{{url}}" class="global-link" title="{{name}}"></a>
					{{#if profile_image}}
					{{>images/other_image other_image=profile_image alt=name}}
					{{else}}
					<span>{{name}}</span>
					{{/if}}
				</div>
				{{/if}}
				{{/foreach}}
			</div>
			<small>{{t "Meet our author"}}</small>
			<small>{{t "Meet our authors"}}</small>
			<small>{{t "Meet our top authors"}}</small>
		</div>
		{{/get}}
		{{/is}}
		{{/if}}
	</div>
	<div class="loop-wrap gh-feed">
		{{#foreach posts}}
		{{>item is_loop=true show_excerpt=true}}
		{{!-- Tag pages below 1200px: the tag's forum topics after the third post, in place of the aside. --}}
		{{#is "tag"}}{{#has number="3"}}{{^is "paged"}}{{> "community-related" strip=true category=../tag.slug}}{{/is}}{{/has}}{{/is}}
		{{!-- Tag pages: the channel's videos after the sixth post, or after the last with fewer. --}}
		{{#is "tag"}}{{^is "paged"}}{{#has number="6"}}{{> "channel-videos" category=../tag.slug}}{{else}}{{#if @last}}{{#has number="1,2,3,4,5"}}{{> "channel-videos" category=../tag.slug}}{{/has}}{{/if}}{{/has}}{{/is}}{{/is}}
		{{/foreach}}
	</div>
</div>