{{!-- This site's own third-party integrations, kept in git rather than in
    Code injection for the history and the review. A site using this theme
    empties this file (or uses Settings -> Code injection instead).

    place="head": inside <head>, before {{ghost_head}} (default.hbs).
    place="foot": end of <body> (site-structure/site-scripts.hbs). --}}
{{#match place "head"}}
{{!-- BTCPay paywall. --}}
<script src='https://pay.criptonautas.co/plugins/Ftaic9XyP8AYSuMKrU2bxw7PrAn9DZjyJKGY62BXThy1/ghost/public/paywall/btcpay-ghost-paywall.js'></script>
{{!-- Webmention receiving endpoint. {{ghost_head}} emits Ghost's own
    (/webmentions/receive/), but Ghost exposes received mentions on the
    Admin API only, so a theme cannot render them - webmentions.js reads
    webmention.io instead. Declared before {{ghost_head}} on purpose: the
    Webmention spec resolves to the first <link> in document order.

    Long comment form: {{! }} ends at the first }}, so the {{ghost_head}}
    above would have closed it early and leaked the rest into the page. --}}
<link rel="webmention" href="https://webmention.io/criptonautas.co/webmention">
{{! IndieAuth identity for signing in to webmention.io. A personal profile,
    not the org: IndieLogin authenticates a GitHub *user* and compares that
    user's profile URL against this one, and an org can neither be
    authenticated as nor carry a link back. That profile's website field
    must be this site for the pair to verify. }}
<link rel="me" href="https://github.com/satonotdead">
{{/match}}
{{#match place "foot"}}
<script defer async data-domain="criptonautas.co"
  src="https://stats.criptonautas.co/js/plausible.outbound-links.js"></script>
<script>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
{{/match}}
