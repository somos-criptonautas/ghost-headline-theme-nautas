{{!-- Back to top, posts and pages. assets/js/to-top.js shows it after a screen of
    scrolling and fills the ring with how much of the article has been read. --}}
<button class="gh-to-top" type="button" aria-label="{{t "Back to top"}}" hidden>
    <svg class="gh-to-top-ring" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <circle class="gh-to-top-track" cx="24" cy="24" r="22" />
        <circle class="gh-to-top-bar" cx="24" cy="24" r="22" pathLength="100" />
    </svg>
    {{> "icons/phosphor/arrow-up"}}
</button>
