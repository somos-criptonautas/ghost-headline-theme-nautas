{{!-- Difficulty, from the internal tags #nivel-1, #nivel-2 and #nivel-3 set in
    the editor: "Nivel 2" - in a card's band, or alone at the top right of an article's
    image. Nothing without one of them. Needs the post's
    tags (include="tags"). --}}
{{#has tag="#nivel-1"}}<span class="gh-level">{{t "Level"}} 1</span>{{/has}}
{{#has tag="#nivel-2"}}<span class="gh-level">{{t "Level"}} 2</span>{{/has}}
{{#has tag="#nivel-3"}}<span class="gh-level">{{t "Level"}} 3</span>{{/has}}
