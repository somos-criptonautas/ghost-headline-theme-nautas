{{!-- More articles (partials/related-posts.hbs). Params: posts, similar_to
    (the post's id: read-next.js orders the cards by meaning). --}}
{{#if posts}}
<div class="gh-read-next gh-canvas" data-similar-to="{{similar_to}}">
    <section class="gh-pagehead">
        <h2 class="gh-pagehead-title">{{t "More articles"}}</h2>
    </section>

    <div class="gh-topic gh-topic-grid">
        <div class="gh-topic-content gh-carousel" tabindex="0" role="region" aria-label="{{t "More articles"}}">
            {{#foreach posts}}
                {{> "loop-grid" has_large_post=false}}
            {{/foreach}}
        </div>
    </div>
</div>
{{/if}}
