{{!-- Discourse comments. The loader, the auto-height and the light/dark sync all
    live in assets/js/discourse-embed.js (bundled into main.min.js): an inline
    script here is subject to the CSP's script hashes and silently stops
    running after any edit. --}}
<div class="comments-section">
    <div class="comments-wrap">
        <small class="global-subtitle-title">{{t "Member discussion"}}</small>
        <div id="discourse-comments" data-embed-url="https://criptonautas.co{{url}}"></div>
    </div>
</div>
