{{#is "post"}}
<aside class="gh-article-sidebar">

    <figure class="gh-author-image-list">
        {{#foreach authors}}
        {{#if profile_image}}
        <a class="author-name-page" href="{{url}}"><img class="author-profile-image" src="{{img_url profile_image size="xs" format="webp" }}" alt="{{name}}" />
        </a>
        {{else}}
        <a class="author-name" href="{{url}}">
            <div class="gh-author-icon">{{> icons/avatar}}</div>
        </a>
        {{/if}}
        {{/foreach}}
    </figure>
    {{!-- Difficulty, right under the feature image, on the right. --}}
    <div class="gh-article-level">{{> "level"}}</div>
    <div class="gh-article-meta">
        <div class="gh-article-meta-inner">
            {{!-- "13 sep 24 (actualizado 10 oct 26)". The update shows only when it
                is on another day than publication and after 2026-10-01: Ghost
                bumps updated_at on any change, and every post here carries an
                August/September 2026 bulk touch that was not a rewrite. The
                YYYY-MM-DD strings compare correctly as text. --}}
            <span class="gh-article-date">
                {{t "published"}} <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{> "short-date" value=published_at}}</time>
                {{#match (date updated_at format="YYYY-MM-DD") ">" "2026-10-01"}}
                {{#match (date updated_at format="YYYY-MM-DD") "!=" (date published_at format="YYYY-MM-DD")}}
                ({{t "updated"}} <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{> "short-date" value=updated_at}}</time>)
                {{/match}}
                {{/match}}
            </span>
        </div>
        <h4 class="gh-author-name-list">
            {{ t "by" }}
            {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{#unless @last}},&nbsp;{{/unless}}{{/foreach}}
        </h4>
    </div>
</aside>
{{/is}}