{{#if @custom.search_host}}
<script src="{{asset "js/search-config.js"}}" data-host="{{@custom.search_host}}" data-key="{{@custom.search_key}}"></script>
{{! Search modal: InstantSearch.js over Typesense, one query across the blog
    (only with the "Search host" setting; without it, Ghost's own search)
    and the forum collections. The two vendor bundles are served from the theme
    rather than a CDN and refreshed by .github/workflows/update-search-vendor.yml;
    all three files stay out of main.min.js - see the js task in gulpfile.js.

    Order matters and defer guarantees it: the vendors define
    window.instantsearch and window.TypesenseInstantSearchAdapter, which
    search-modal.js needs, and every classic script - including the config
    above - has already run by the time the first deferred one does. }}
<script defer src="{{asset "js/instantsearch.min.js"}}"></script>
<script defer src="{{asset "js/typesense-instantsearch-adapter.min.js"}}"></script>
<script defer src="{{asset "js/search-modal.js"}}"></script>
{{/if}}
<script defer async data-domain="criptonautas.co"
  src="https://stats.criptonautas.co/js/plausible.outbound-links.js"></script>
