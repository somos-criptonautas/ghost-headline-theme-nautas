{{! External links: assets/js/external-links.js, inside main.min.js. }}
{{! Prefetch of internal links on hover or touch (the browser's own Speculation
    Rules; flying-pages.min.js before). Prefetch only - prerendering would run
    the page's scripts, analytics included, for pages never visited. Members,
    admin, redirect and query links are left alone. Browsers without support
    ignore the block. The CSP allows inline scripts ('unsafe-inline'). }}
<script type="speculationrules">
{"prefetch": [{"where": {"and": [{"href_matches": "/*"}, {"not": {"href_matches": ["/ghost/*", "/members/*", "/r/*", "/*\\?*"]}}, {"not": {"selector_matches": "[target=_blank], [data-portal], [rel~=nofollow]"}}]}, "eagerness": "moderate"}]}
</script>
{{#if @custom.search_host}}
<script src="{{asset "js/search-config.js"}}" data-host="{{@custom.search_host}}" data-key="{{@custom.search_key}}"></script>
{{! Search modal: InstantSearch.js over Typesense, one query across the blog
    (only with the "Search host" setting; without it, Ghost's own search)
    and the forum collections. The two vendor bundles are served from the theme
    rather than a CDN and refreshed by .github/workflows/update-search-vendor.yml;
    all three files stay out of main.min.js - see the js task in gulpfile.js.

    Order matters and defer guarantees it: the vendors define
    window.instantsearch and window.TypesenseInstantSearchAdapter, which
    search-modal.js needs, and every classic script - including the config
    above - has already run by the time the first deferred one does. }}
<script defer src="{{asset "js/instantsearch.min.js"}}"></script>
<script defer src="{{asset "js/typesense-instantsearch-adapter.min.js"}}"></script>
<script defer src="{{asset "js/search-modal.js"}}"></script>
{{! The search modal's strings, read by search-modal.js. }}
<template id="ns-i18n"><span data-k="Search">{{t "Search"}}</span><span data-k="replies">{{t "replies"}}</span><span data-k="Search this site">{{t "Search this site"}}</span><span data-k="search posts and stories…">{{t "search posts and stories…"}}</span><span data-k="Sources">{{t "Sources"}}</span><span data-k="blog">{{t "blog"}}</span><span data-k="community">{{t "community"}}</span><span data-k="mushin">{{t "mushin"}}</span><span data-k="videos">{{t "videos"}}</span><span data-k="searches our videos, what is said in them included">{{t "searches our videos, what is said in them included"}}</span><span data-k="searches published articles">{{t "searches published articles"}}</span><span data-k="searches our community">{{t "searches our community"}}</span><span data-k="searches curated links, off the site">{{t "searches curated links, off the site"}}</span><span data-k="← back to results">{{t "← back to results"}}</span><span data-k="view in the community">{{t "view in the community"}}</span><span data-k="opens in a new tab">{{t "opens in a new tab"}}</span><span data-k="view in videos">{{t "view in videos"}}</span><span data-k="see replies">{{t "see replies"}}</span><span data-k="AI summary">{{t "AI summary"}}</span><span data-k="Common searches">{{t "Common searches"}}</span><span data-k="search failed; try again in a moment">{{t "search failed; try again in a moment"}}</span><span data-k="no results for">{{t "no results for"}}</span></template>
{{/if}}
