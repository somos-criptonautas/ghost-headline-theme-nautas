{{!-- Latest forum topics as horizontal cards. Post templates pass the primary
    tag (category=): the forum category with that slug, after the
    comments. Without them - /blog - the latest topics from the whole forum.
    Filled by assets/js/community-sidebar.js from the forum's public JSON
    (same CORS setup as the sidebar); it stays hidden until there is something
    to show, so a tag with no matching category, or a forum that does not
    answer, leaves no trace.

    Tag pages: after the first page's last post, the whole forum's topics
    when the tag has no category.

    strip=true (index.hbs after the third post, on phones):
    six cards in one sideways row,
    shown from the start with a card's height kept while they load, so the
    page does not jump when they arrive.

    count= (home.hbs): how many cards instead of four. --}}
{{#if @custom.discourse_url}}
<section class="gh-community-related{{#if strip}} gh-community-strip{{/if}}" aria-labelledby="gh-community-related-title"{{#if strip}} aria-busy="true" data-count="6"{{else}} hidden{{#if count}} data-count="{{count}}"{{/if}}{{/if}}
    data-category="{{category}}"
    data-label-reply="{{t "reply"}}"
    data-label-replies="{{t "replies"}}">
    {{!-- The strip is a card in a list and keeps the small heading with the
        forum icon; under an article and on the landing the heading is a
        block's, as "More articles" and "Featured". --}}
    {{#if strip}}
    <h2 class="gh-community-related-title" id="gh-community-related-title">
        {{> "icons/discourse"}}
        {{t "Community"}}
    </h2>
    {{else}}
    <section class="gh-pagehead">
        <h2 class="gh-pagehead-title" id="gh-community-related-title">{{t "Community"}}</h2>
    </section>
    {{/if}}
    <ol class="gh-community-cards{{#if strip}} gh-carousel{{/if}}"></ol>
    <a class="gh-community-more" target="_blank" rel="noopener">{{t "Go to the community"}} {{> "icons/phosphor/arrow-square-out"}}</a>
    {{!-- A card opens its topic here (community-sidebar.js). --}}
    <dialog class="gh-community-dialog" aria-labelledby="gh-community-dialog-title">
        <header class="gh-community-dialog-head">
            <h3 class="gh-community-dialog-title" id="gh-community-dialog-title"></h3>
            <p class="gh-community-dialog-meta"></p>
        </header>
        <div class="gh-community-dialog-body"></div>
        <footer class="gh-community-dialog-foot">
            <a class="gh-community-dialog-out" target="_blank" rel="noopener">{{t "view in the community"}} {{> "icons/phosphor/arrow-square-out"}}</a>
            <button class="gh-community-dialog-close" type="button">{{t "Close"}}</button>
        </footer>
    </dialog>
</section>
{{/if}}
