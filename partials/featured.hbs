{{!-- "Blog": the posts starred as featured in Ghost, the newest three,
    at the foot of the landing (home.hbs) as "More articles" sits under a post
    (read-next.hbs). --}}
{{#get "posts" include="tags,authors" filter="featured:true" limit="3"}}
{{#if posts}}
<div class="gh-read-next gh-canvas">
    <section class="gh-pagehead">
        <h2 class="gh-pagehead-title">{{t "Blog"}}</h2>
    </section>

    <div class="gh-topic gh-topic-grid">
        <div class="gh-topic-content">
            {{#foreach posts}}
                {{> "loop-grid" has_large_post=false}}
            {{/foreach}}
        </div>
    </div>
</div>
{{/if}}
{{/get}}
