{{!-- Destacado: the posts starred as featured in Ghost, up to four, on the
    landing (home.hbs). --}}
{{#get "posts" include="tags,authors" filter="featured:true" limit="4"}}
{{#if posts}}
<section class="gh-topic gh-topic-grid gh-featured">
    <h2 class="gh-topic-name">{{t "Featured"}}</h2>
    <div class="gh-topic-content">
        {{#foreach posts}}
        {{> "loop-grid"}}
        {{/foreach}}
    </div>
</section>
{{/if}}
{{/get}}
