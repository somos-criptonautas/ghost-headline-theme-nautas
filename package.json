{
    "name": "ghost-headline-theme-nautas",
    "description": "Ghost theme for communities: a blog that works as the front page of a Discourse forum",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22"
    },
    "license": "MIT",
    "author": {
        "name": "Criptonautas",
        "email": "dev@criptonautas.co"
    },
    "keywords": [
        "ghost",
        "ghost-theme"
    ],
    "docs": "https://headline.ghost.io/about/",
    "config": {
        "posts_per_page": 7,
        "image_sizes": {
            "xs": {
                "width": 150
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 720
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "dark_logo": {
                "type": "image",
                "description": "Logo for dark mode. Empty: the publication logo."
            },
            "discourse_url": {
                "type": "text",
                "default": "https://comunidad.criptonautas.co",
                "description": "Discourse forum URL for comments, reactions, the community lists and tips. Empty turns them all off."
            },
            "search_host": {
                "type": "text",
                "default": "typesense.criptonautas.co",
                "description": "Typesense host for the search modal. Empty: Ghost's own search."
            },
            "search_key": {
                "type": "text",
                "default": "8hPtZRIeBeU4MM7c6Fy9viwynvG1F2F4",
                "description": "Typesense search-only key. Never an admin key: it is public."
            },
            "github_url": {
                "type": "text",
                "default": "https://github.com/somos-criptonautas/",
                "description": "GitHub link in the footer. Empty hides it."
            },
            "footer_note": {
                "type": "text",
                "default": "(no estamos en Discord)",
                "description": "Short line under the footer icons."
            },
            "discourse_comments": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "discourse_reactions": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Emoji reactions from the post's forum topic."
            },
            "monero_tips_username": {
                "type": "text",
                "default": "anonist",
                "group": "post",
                "description": "Forum account that receives Monero tips (discourse-monero-tips plugin). Empty hides them."
            },
            "community_sidebar": {
                "type": "select",
                "options": ["Off", "Latest topics", "Latest posts"],
                "default": "Latest topics",
                "group": "homepage",
                "description": "Discourse topics or posts beside the home and tag pages. Needs CORS on the forum."
            },
            "peertube_source": {
                "type": "text",
                "description": "Videos page: PeerTube URL, optionally | category ids, e.g. https://host | 15, 13 Educación"
            },
            "newsletter_form": {
                "type": "text",
                "description": "Keila form address (https://…/forms/nfrm_…): the editor's signup cards show and send their e-mail there, without Portal."
            }
        }
    },
    "scripts": {
        "dev": "gulp",
        "test": "gscan .",
        "zip": "gulp zip"
    },
    "packageManager": "pnpm@12.10.1",
    "devDependencies": {
        "@tryghost/shared-theme-assets": "2.7.5",
        "@tryghost/theme-translations": "^0.0.22",
        "autoprefixer": "10.6.1",
        "beeper": "2.1.0",
        "cssnano": "9.3.2",
        "gscan": "6.6.1",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "5.1.0",
        "ordered-read-streams": "2.0.0",
        "postcss": "8.5.29",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.4"
    }
}
