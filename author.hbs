{{!< default}} {{#author}} <div class="global-padding archive-section{{#if profile_image}} is-image{{/if}}">
    {{#if profile_image}}
    <div class="global-image-author">
        {{>images/other_image other_image=profile_image alt=name}}
    </div>
    {{/if}}
    <h1 class="archive-title global-title">{{name}}</h1>
    {{!-- Phosphor duotone icons (MIT, partials/icons/phosphor/LICENSE).
        Phosphor has no Bluesky mark; its butterfly stands in. --}}
    {{#has any="website,twitter,facebook,linkedin,bluesky,threads,mastodon,tiktok,youtube,instagram"}}
    <div class="gh-author-social">
        {{#if twitter}}
        <a class="gh-author-social-link" href="{{social_url type="twitter"}}" target="_blank" rel="me noopener" aria-label="Twitter">{{> "icons/phosphor/twitter"}}</a>
        {{/if}}
        {{#if facebook}}
        <a class="gh-author-social-link" href="{{social_url type="facebook"}}" target="_blank" rel="me noopener" aria-label="Facebook">{{> "icons/phosphor/facebook"}}</a>
        {{/if}}
        {{#if linkedin}}
        <a class="gh-author-social-link" href="{{social_url type="linkedin"}}" target="_blank" rel="me noopener" aria-label="LinkedIn">{{> "icons/phosphor/linkedin"}}</a>
        {{/if}}
        {{#if bluesky}}
        <a class="gh-author-social-link" href="{{social_url type="bluesky"}}" target="_blank" rel="me noopener" aria-label="Bluesky">{{> "icons/phosphor/bluesky"}}</a>
        {{/if}}
        {{#if threads}}
        <a class="gh-author-social-link" href="{{social_url type="threads"}}" target="_blank" rel="me noopener" aria-label="Threads">{{> "icons/phosphor/threads"}}</a>
        {{/if}}
        {{#if mastodon}}
        <a class="gh-author-social-link" href="{{social_url type="mastodon"}}" target="_blank" rel="me noopener" aria-label="Mastodon">{{> "icons/phosphor/mastodon"}}</a>
        {{/if}}
        {{#if tiktok}}
        <a class="gh-author-social-link" href="{{social_url type="tiktok"}}" target="_blank" rel="me noopener" aria-label="TikTok">{{> "icons/phosphor/tiktok"}}</a>
        {{/if}}
        {{#if youtube}}
        <a class="gh-author-social-link" href="{{social_url type="youtube"}}" target="_blank" rel="me noopener" aria-label="YouTube">{{> "icons/phosphor/youtube"}}</a>
        {{/if}}
        {{#if instagram}}
        <a class="gh-author-social-link" href="{{social_url type="instagram"}}" target="_blank" rel="me noopener" aria-label="Instagram">{{> "icons/phosphor/instagram"}}</a>
        {{/if}}
        {{#if website}}
        <a class="gh-author-social-link" href="{{website}}" target="_blank" rel="me noopener" aria-label="{{t "Website"}}">{{> "icons/phosphor/website"}}</a>
        {{/if}}
    </div>
    {{/has}}
    {{#if bio}}
    <p class="archive-excerpt global-excerpt">{{bio}}</p>
    {{/if}}
    </div>
    {{/author}}
    {{>loop}}