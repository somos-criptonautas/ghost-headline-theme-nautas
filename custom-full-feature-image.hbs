{{!< default}} {{#post}} <section class="gh-cover gh-outer">
    {{#if feature_image}}
    <img class="gh-cover-image gh-feature-image" loading="lazy" srcset="{{img_url feature_image size="s" format="webp"
        }} 300w, {{img_url feature_image size="m" format="webp" }} 720w, {{img_url feature_image size="l" format="webp"
        }} 960w, {{img_url feature_image size="xl" format="webp" }} 1200w, {{img_url feature_image size="xxl"
        format="webp" }} 2000w" sizes="100vw" src="{{img_url feature_image size="xl" format="webp" }}" alt="{{title}}">
    {{/if}}
    <div class="gh-cover-content">
        {{> "breadcrumb"}}

        <h1 class="gh-cover-title">{{title}}</h1>
        {{#if custom_excerpt}}
        <p class="gh-article-excerpt">{{custom_excerpt}}</p>
        {{/if}}
    </div>
    </section>

    <main class="gh-main">
        {{#is "post"}}
        <article class="gh-article {{post_class}}">
            <header class="gh-article-header gh-canvas">
            </header>
            <div class="gh-author">
                {{> "post-meta"}}

            </div>
            <div class="gh-full-content">
                <aside class="gh-sidebar" id="sidebar-toc">
                    {{#if reading_time}}
                    <h3>
                        {{reading_time minute="1 min de lectura" minutes="% mins de lectura"}}
                    </h3>
                    {{/if}}
                    <div class="toc">
                    </div>
                    {{> "post-share" comments=true}}
                </aside>
                <section class="gh-content gh-canvas">
                    {{content}}
                </section>
            </div>
            {{> "post-share" end=true}}
            {{> "comments"}}
            {{>webmentions}}
            {{#if primary_tag}}{{> "community-related" category=primary_tag.slug label=primary_tag.name}}{{/if}}
            {{else}}
            <section class="gh-content gh-canvas">
                {{content}}
            </section>
            {{/is}}
        </article>
        {{/post}}
        {{> "related-posts"}}

    </main>
    {{#contentFor "body_class"}} has-full-image{{/contentFor}}