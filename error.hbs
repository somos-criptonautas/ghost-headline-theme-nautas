{{!< default}}

<main class="gh-main gh-outer">
    <div class="gh-inner">
		<div class="error-center">
{{#match statusCode 404}}
<p class="error-kicker">{{t "Page not found"}}</p>
<div class="error-code" role="img" aria-label="404"><span aria-hidden="true">4</span><svg viewBox="0 0 48 48" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><use href="{{asset "images/anonist-sprite.svg"}}#anonist-48-mask-idle"></use></svg><span aria-hidden="true">4</span></div>
{{else}}
<p class="error-kicker">error {{statusCode}}</p>
{{/match}}
<h1>{{ t "Somebody turned off" }}</h1>
<p>{{ t "Please check our last articles" }}
		</p></div>
        {{!-- The latest posts as /blog lists them (index.hbs). --}}
        <section class="gh-topic gh-topic-grid gh-topic-grid-item gh-listing">
            <div class="gh-topic-content">
                {{#get "posts" include="tags,authors" limit="6"}}
                    {{#foreach posts}}
                        {{> "loop-grid" has_large_post=false}}
                    {{/foreach}}
                {{/get}}
            </div>
        </section>
    </div>
</main>

<script>plausible("404",{ props: { path: document.location.pathname } });</script>
 