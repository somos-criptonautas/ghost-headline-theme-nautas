pen .gh-head {\n  background-color: var(--color-bg) !important;\n  height: 100vh;\n}\n\n.gh-head .nav {\n  font-size: 2.11rem;\n}\n\n/* Clickable card overlay */\n.global-link {\n  position: absolute;\n  z-index: 1;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  text-transform: uppercase;\n}\n\n.gh-foot .gh-outer {\n  opacity: 0.77;\n}\n\n.gh-icon-btn svg:hover,\n.gh-icon-btn svg:active {\n  fill: var(--color-base);\n}\n\nimg {\n  border-radius: var(--radius);\n}\n\nul.nav li:hover,\n.nav-current {\n  box-shadow: 0 -3px 0 0 var(--color-base) inset;\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  color: var(--color-base);\n  font-family: var(--gh-font-heading);\n  /* Brand kit: headings at 800, tracking tightened. */\n  font-weight: 800;\n  letter-spacing: -0.02em;\n}\n\nh1,\nh2,\nh3 {\n  padding-bottom: 2rem;\n}\n\nh4,\nh5 {\n  padding-bottom: 1.5rem;\n}\n\nh1 {\n  font-size: var(--h1-size);\n  font-weight: 800;\n}\n\nh2 {\n  font-size: 3.7rem;\n}\n\nh3 {\n  font-size: 3.33rem;\n}\n\nh4 {\n  font-size: 2.8rem;\n}\n\nh5 {\n  font-size: 2.6rem;\n}\n\n@media screen and (max-width: 767px) {\n  h2 {\n    font-size: 3rem;\n  }\n\n  h3 {\n    font-size: 2.65rem;\n  }\n\n  h4 {\n    font-size: 2rem;\n  }\n\n  h5 {\n    font-size: 1.75rem;\n  }\n}\n\n/* Newsletter */\n\n.newsletter p {\n  margin-top: 3rem;\n}\n\n.newsletter {\n  background: var(--color-bg);\n  height: 100%;\n  overflow: auto;\n  position: absolute;\n  transform: var(--transform);\n  height: 100%;\n  width: 100%;\n  z-index: 99999999;\n  display: none;\n  justify-content: center;\n  text-align: center;\n  align-items: center;\n  flex-direction: column;\n  padding: 1rem 1rem 10rem 1rem;\n}\n\n.flex {\n  display: flex;\n}\n\n.newsletter.container {\n  height: 100vh;\n  max-width: 90%;\n  display: flex;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.newsletter-title {\n  letter-spacing: 0.025em;\n  font-size: 5.5rem;\n  line-height: 1;\n  font-weight: 700;\n  padding: 2rem 0;\n}\n\n.newsletter-title.descriptio