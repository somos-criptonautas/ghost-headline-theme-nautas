35;\n  margin-top: 4vh;\n}\n\n.post-meta>div {\n  align-self: center;\n  margin-bottom: 5px;\n}\n\n.post-meta-content {\n  opacity: var(--opacity-two);\n}\n\n.post-meta time {\n  display: block;\n}\n\n.post-meta a:hover {\n  text-decoration: underline;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 1px;\n}\n\n.global-padding {\n  max-width: var(--max-width-global-wrap);\n  margin-right: auto;\n  margin-left: auto;\n  padding-right: var(--margin-wrap-left-right);\n  padding-left: var(--margin-wrap-left-right);\n}\n\n@media (min-width: 768px) {\n  .post-header-wrap.is-center {\n    text-align: center;\n  }\n\n  .post-header-wrap.is-center .post-header-content,\n  .post-header-wrap.is-classic .post-header-content {\n    padding-top: 0;\n  }\n\n  .page-template .post-header-wrap.is-center .post-header-content {\n    padding-top: 2vh;\n  }\n\n  .post-header-wrap.is-center .post-header-content,\n  .post-header-wrap.is-center .post-header-image,\n  .post-header-wrap.is-center .post-excerpt,\n  .post-header-wrap.is-center .post-meta,\n  .post-header-wrap.is-classic .post-header-content,\n  .post-header-wrap.is-classic .post-header-image {\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .post-header-wrap.is-center .post-tags {\n    justify-content: center;\n  }\n\n  .post-header-wrap.is-center .post-meta,\n  .post-header-wrap.is-classic .post-header-container {\n    flex-direction: column;\n  }\n\n  .post-header-wrap.is-center .post-authors {\n    margin-left: 3px;\n  }\n\n  .post-header-wrap.is-center .post-item-author:last-of-type {\n    margin-right: 0;\n  }\n\n  .post-header-wrap.is-center .post-header-image,\n  .post-header-wrap.is-classic .post-header-image {\n    margin-top: 4vh;\n    padding-left: 0;\n  }\n\n  .post-header-wrap.is-center .post-header-image,\n  .post-header-wrap.is-classic .post-header-image,\n  .post-header-wrap.is-classic .post-header-content {\n    width: 100%;\n  }\n\n  .post-header-wrap.is-classic .post-title {\n    max-width: 88%;\n  }\n\n  .post-header-wrap.is-center .post-header-image {\n    max-width: 80%;\n  }\n\n  .post-header-wrap.is-classic .post-excerpt {\n    max-width: 820px;\n  }\n}\n\n@media (min-width: 1025px) {\n  .post-header-wrap.is-center .post-header-content {\n    max-width: 1050px;\n  }\n\n  .post-header-wrap.is-center .post-excerpt {\n    max-width: 780px;\n  }\n}\n\n@media (min-width: 1481px) {\n\n  .post-header-wrap.is-classic .post-header-content,\n  .post-header-wrap.is-classic .post-header-image {\n    max-width: calc(var(--max-width-post-wrap) + 180px + 180px);\n  }\n\n  .post-title {\n    font-size: 6.6rem;\n  }\n}\n\n@media (max-width: 1480px) and (min-width: 768px) {\n\n  .post-header-wrap.is-classic .post-header-content,\n  .post-header-wrap.is-classic .post-header-image {\n    max-width: calc(var(--max-width-post-wrap) + 70px + 70px);\n  }\n\n  .post-header-wrap.is-center .post-header-image {\n    max-width: calc(var(--max-width-post-wrap) + 180px + 180px);\n  }\n}\n\n@media (min-width: 1601px) {\n  .post-title {\n    font-size: 7.4rem;\n  }\n}\n\n/* Subtitle */\n.global-subtitle {\n  display: flex;\n  margin-bottom: 2vh;\n  padding-top: 1.8vh;\n  border-top: var(--border) var(--color-border-one);\n  text-align: center;\n}\n\n.global-subtitle-title {\n  font-size: 2rem;\n  line-height: 1.1;\n  flex: 1 0 50%;\n  max-width: 800px;\n  margin: 0;\n}\n\n.global-subtitle span {\n  font-weight: 800;\n}\n\n/* Author & Tag page */\n@media (min-width: 768px) {\n  .archive-section {\n    margin-top: 11vh;\n  }\n}\n\n/* Phones: author, tag, /tags/ and /authors/ start at the same height as an\n   article - .gh-main's 5rem below the header. They have no .gh-main, so the\n   header sat directly on the title (or on the avatar / tag image). */\n@media (max-width: 767px) {\n  .archive-section {\n    padding-top: 5rem;\n  }\n\n  .archive-section .archive-image {\n    margin-top: 0;\n  }\n}\n\n.archive-section .global-title {\n  text-transform: uppercase;\n  padding: 0 1rem;\n}\n\n.archive-section {\n  text-align: center;\n  padding-bottom: 3.33rem;\n}\n\n.archive-section.left {\n  text-align: unset;\n}\n\n.archive-social,\n.archive-excerpt {\n  margin: 3rem auto;\n}\n\n.author-template .archive-title {\n  cursor: none;\n  padding-top: 1rem;\n}\n\n.archive-title {\n  box-sizing: border-box;\n  padding: 0 var(--margin-wrap-left-right);\n}\n\n.archive-excerpt .global-title {\n  text-transform: uppercase;\n  display: inherit;\n}\n\n.archive-image img,\n.archive-title span {\n  background-color: var(--color-one);\n}\n\n/* Image. Square box: the img is rounded to a circle, and with only a height\n   set it took the full width and came out as a wide ellipse on phones. */\n.archive-image {\n  position: relative;\n  width: 11rem;\n  height: 11rem;\n  margin: 2rem auto 20px;\n}\n\n.archive-image img {\n  box-sizing: border-box;\n  padding: 10px;\n  border-radius: 100%;\n}\n\n/* Title & Counter */\n.archive-title {\n  position: relative;\n  margin-bottom: 3.3rem;\n}\n\n.archive-excerpt .level {\n  background-color: var(--color-gray) !important;\n  color: var(--color-bg);\n  padding: 0.73rem 1.23rem;\n  margin-right: 1rem;\n}\n\n.archive-title.is-tag {\n  transform: translateX(-5px);\n}\n\n.archive-title.is-tag span {\n  font-family: var(--gh-font-heading);\n  font-size: 1.8rem;\n  font-weight: 800;\n  margin-left: 6px;\n  padding: 0 0 0.63rem 0.33rem;\n  border-radius: 100px;\n}\n\n/* Excerpt */\n.archive-excerpt {\n  max-width: 880px;\n}\n\n@media screen and (max-width: 767px) {\n  .archive-excerpt {\n    max-width: 90vw;\n  }\n}\n\n/* Details */\n.account-details {\n  max-width: 600px;\n  padding: 0 var(--margin-wrap-left-right);\n  display: flex;\n  margin: auto;\n}\n\n.account-details-wrap,\n.account-detail-column>div {\n  box-sizing: border-box;\n}\n\n.account-details-wrap {\n  margin-bottom: 10px;\n  background-color: var(--color-nine);\n  width: 250px;\n  margin: auto;\n}\n\n.account-details-content {\n  display: flex;\n}\n\n.account-detail-column {\n  flex-basis: auto;\n  min-width: 210px;\n  padding-right: 35px;\n}\n\n.account-detail-column>div {\n  padding: 12px 0;\n}\n\n.account-detail-column+small {\n  margin-top: 12px;\n}\n\n.account-details-title {\n  font-family: var(--gh-font-heading);\n  font-size: 1.8rem;\n  font-weight: 800;\n  box-sizing: border-box;\n  margin: 0;\n  padding: 30px 6% 0;\n}\n\n.account-detail-heading {\n  font-size: 1.4rem;\n  line-height: 1;\n  display: block;\n}\n\n.account-detail-content {\n  font-size: 1.6rem;\n  font-weight: 500;\n  display: inline-block;\n  margin-top: 10px;\n}\n\n/* Sign out button */\n\n.account-signout {\n  font-size: 2rem;\n  padding: 12px 26px;\n  margin-left: 1rem;\n}\n\n/* Expired */\n.account-alert-expired {\n  font-size: 1.2rem;\n}\n\n/* Buttons */\n.account-buttons {\n  font-size: 1.2rem;\n  position: relative;\n  display: flex;\n  flex-wrap: wrap;\n  float: left;\n}\n\n.account-button {\n  font-size: 2rem;\n}\n\n.account-button:hover {\n  text-decoration: underline;\n}\n\n.account-button+.cancel-error {\n  position: absolute;\n  bottom: -6vh;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.account-button.error+.cancel-error {\n  display: inline-table;\n  color: var(--color-font-black);\n  background-color: var(--color-alert-error);\n}\n\n/* Matenauta stuff */\n\n.sidebar-toc h3 {\n  font-size: 2.73rem;\n}\n\n.archive-social a:hover {\n  text-decoration: underline;\n}\n\n.tag {\n  text-transform: uppercase;\n  margin-bottom: 5.33 rem;\n}\n\n/* Image */\n.global-image-author img {\n  width: 11rem;\n  margin: auto;\n}\n\n.global-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.global-bg-image {\n  background: no-repeat center center/cover;\n}\n\n/* Image orientation */\n.global-image-orientation {\n  line-height: 0;\n  position: relative;\n  width: 100%;\n  margin: 0;\n  transition: transform 0.11s ease;\n  aspect-ratio: 1/1.2;\n  max-height: 23vh;\n}\n\n.global-image-orientation>img {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n}\n\n.global-image-orientation.is-landscape {\n  aspect-ratio: 4/3;\n}\n\n.global-image-orientation.is-square {\n  aspect-ratio: 1/1;\n}\n\n.global-image-orientation.is-natural {\n  padding-bottom: 0;\n  aspect-ratio: initial;\n}\n\n.global-image-orientation.is-natural>img {\n  position: relative;\n}\n\n@supports not (aspect-ratio: 1/1) {\n  .global-image-orientation {\n    padding-bottom: 120%;\n  }\n\n  .global-image-orientation.is-landscape {\n    padding-bottom: 75%;\n  }\n\n  .global-image-orientation.is-square {\n    padding-bottom: 100%;\n  }\n}\n\n/* Border radius */\n.global-radius {\n  overflow: hidden;\n  border-radius: var(--border-radius);\n}\n\n@media screen and (max-width: 991px) {\n  body.page-template.page-tags.gh-site {\n    padding-top: 11vh;\n  }\n}\n\n.page-tags .global-subtitle,\n.tag-template .global-subtitle {\n  opacity: 0;\n}\n\n.no-estamos {\n  margin: auto;\n  text-align: center;\n  font-size: 1rem;\n  opacity: 0.33;\n  color: var(--color-bg);\n  display: inherit;\n}\n\n.membership-card:nth-child(1) .membership-card-list li:nth-child(4),\n.membership-card:nth-child(1) .membership-card-list li:nth-child(5) {\n  visibility: hidden;\n}\n\n.page-lounge typebot-bubble,\n.page-working typebot-bubble:nth-of-type(2),\n.page-profile typebot-bubble:nth-of-type(2) {\n  display: none;\n}\n\n.page-working .gh-btn.center {\n  margin: auto;\n}\n\n.page-lounge main.gh-main {\n  padding-top: 0;\n  padding-bottom: 3rem;\n}\n\n.page-lounge .gh-foot {\n  padding: 0;\n}\n\n.page-lounge .gh-article .gh-content {\n  margin-top: 0;\n}\n\n.page-lounge .gh-article .gh-content .gh-canvas {\n  grid-template-columns: none !important;\n}\n\n.page-lounge .gh-article-header,\n.page-lounge .gh-foot-menu,\n.page-lounge .it-foot-social {\n  display: none;\n}\n\n.page-lounge iframe {\n  width: 98vw;\n}\n\n/* /blog/ and /page/2/ onward (index.hbs): the homepage's cards - two per\n   row from 992px, one below - instead of the one-card-per-row\n   layout the other listings use, which drew every post at full page width.\n   The 23vh/33vh padding of .gh-topic-grid-item and the empty pagehead's\n   margin went with it. */\n.gh-listing.gh-topic-grid-item {\n  padding: 0;\n}\n\n.gh-main:has(.gh-listing) .gh-pagehead {\n  margin-bottom: 0;\n}\n\nbody:not(.home-template) .gh-listing .gh-topic-content {\n  grid-template-columns: minmax(0, 1fr);\n  row-gap: 3.33rem;\n  column-gap: 2.22rem;\n  justify-items: stretch;\n  max-width: none;\n}\n\nbody:not(.home-template) .gh-listing .gh-card {\n  grid-column: auto;\n}\n\n/* The space between cards: the same on /blog and on tag pages, from the tag\n   pages' own spacing, a little wider. Phones keep theirs. */\n@media screen and (min-width: 768px) {\n  body .loop-wrap,\n  body:not(.home-template) .gh-listing .gh-topic-content {\n    column-gap: 2rem;\n    row-gap: 7.2rem;\n  }\n\n  body .loop-wrap .item.is-loop {\n    margin-bottom: 0;\n  }\n}\n\n/* /blog: the level switches (index.hbs, assets/js/levels.js) above the list,\n   a small track and knob before each label, in the ink of the page; the\n   cards of the levels switched off leave the list. */\n.gh-levels {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 1.2rem 2.4rem;\n  margin: 0 0 3.2rem;\n}\n\n.gh-levels[hidden] {\n  display: none;\n}\n\n.gh-level-switch {\n  all: unset;\n  position: relative;\n  display: inline-flex;\n  gap: 1rem;\n  align-items: center;\n  color: var(--color-base);\n  font-size: 1.7rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  cursor: pointer;\n}\n\n/* The track (::before) and its knob (::after), which slides across. */\n.gh-level-switch::before {\n  content: \"\";\n  flex: none;\n  width: 4rem;\n  height: 2.2rem;\n  border: 2px solid var(--color-base);\n  border-radius: 99rem;\n  box-sizing: border-box;\n  transition: background-color 0.2s ease;\n}\n\n.gh-level-switch::after {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 0.3rem;\n  width: 1.2rem;\n  height: 1.2rem;\n  border-radius: 50%;\n  background-color: var(--color-base);\n  transform: translateY(-50%);\n  transition: transform 0.2s ease, background-color 0.2s ease;\n}\n\n.gh-level-switch[aria-checked=\"true\"]::before {\n  background-color: var(--color-base);\n}\n\n.gh-level-switch[aria-checked=\"true\"]::after {\n  background-color: var(--color-bg);\n  transform: translate(2.2rem, -50%);\n}\n\n/* Cards a switch brings back come in, rather than popping (levels.js adds\n   is-switched on the first switch, so the first load does not animate). */\n@keyframes gh-level-in {\n  from {\n    opacity: 0;\n    transform: translateY(0.8rem);\n  }\n}\n\n.gh-feed.is-switched > .gh-card {\n  animation: gh-level-in 0.25s ease;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .gh-feed.is-switched > .gh-card {\n    animation: none;\n  }\n\n  .gh-level-switch::after {\n    transition: none;\n  }\n}\n\n.gh-level-switch[aria-checked=\"false\"] {\n  color: var(--color-secondary-text);\n}\n\n.gh-level-switch:focus-visible {\n  outline: 2px solid var(--ghost-accent-color);\n  outline-offset: 4px;\n}\n\n.gh-feed.is-hidden-hash-nivel-1 > .tag-hash-nivel-1,\n.gh-feed.is-hidden-hash-nivel-2 > .tag-hash-nivel-2,\n.gh-feed.is-hidden-hash-nivel-3 > .tag-hash-nivel-3,\n.gh-feed.is-filtered > .gh-card:not(.tag-hash-nivel-1, .tag-hash-nivel-2, .tag-hash-nivel-3) {\n  display: none;\n}\n\nbody:not(.home-template) .gh-listing .gh-card .gh-card-link:nth-child(even) {\n  flex-direction: inherit;\n}\n\n@media screen and (min-width: 992px) {\n  body:not(.home-template) .gh-listing .gh-topic-content {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n/* Listing titles take the related-posts cards' size from 768px, so they\n   don't grow when the community column drops out below 1200px. */\n@media screen and (min-width: 768px) {\n  body:not(.home-template) .gh-listing .gh-card .gh-card-title {\n    font-size: 3rem;\n    line-height: 1.15;\n  }\n}\n\n/* Next to the community sidebar the homepage cards are about half as wide,\n   so their titles drop from var(--h1-size) to the 3rem of the related-posts\n   cards. Without the sidebar they keep the full size. */\n@media screen and (min-width: 1200px) {\n  .gh-with-sidebar:has(> .gh-community:not([hidden])) .gh-topic-grid .gh-card .gh-card-title {\n    font-size: 3rem;\n    line-height: 1.15;\n  }\n}\n\n.gh-card {\n  word-break: unset;\n}\n\n.faq-content {\n  display: grid;\n  -webkit-box-pack: justify;\n  -ms-flex-pack: justify;\n  justify-content: space-between;\n  grid-gap: 8vmin 12vmin;\n  grid-template-columns: 1fr 1fr;\n}\n\n.pricingtable,\n.pricingtable-plan {\n  -webkit-box-pack: justify;\n  -ms-flex-pack: justify;\n  justify-content: space-between;\n}\n\n.pricing-table-plan {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  -webkit-box-orient: vertical;\n  -webkit-box-direction: normal;\n  -ms-flex-direction: column;\n  flex-direction: column;\n  padding: 30px;\n  border: 1px solid var(--color-border);\n  color: var(--color-base);\n  border-radius: 8px;\n}\n\n.pricingtable-plan:hover {\n  border-color: var(--color-primary);\n  text-decoration: none;\n}\n\n.pricing-table {\n  display: grid;\n  grid-gap: 1rem;\n  grid-template-columns: 1fr 1fr;\n  max-width: 720px;\n  margin: 5vw auto;\n}\n\n.kg-callout-card {\n  padding: 1.7em 1.5em;\n}\n\n@media screen and (max-width: 767px) {\n  .kg-callout-emoji {\n    margin-left: -4rem;\n    margin-top: -4rem;\n    font-size: 4.5 rem !important;\n    padding: 0.33rem !important;\n  }\n}\n\n.beta-box {\n  max-width: 666px;\n  margin: 0 auto 3rem;\n}\n\n.subscribe-section img {\n  width: 77%;\n  margin: 0 auto 3rem;\n}\n\n.discourse .button {\n  color: var(--color-base);\n}\n\n/* The comments partial is a sibling of .gh-full-content, not a child of\n   .gh-content, so it is free of the column the TOC sidebar pushes right and\n   centres on the page like any block. */\n.comments-section {\n  max-width: min(var(--content-width), calc(100vw - 2 * var(--gap)));\n  margin-inline: auto;\n  /* \"Go to comments\" (#comments) lands on the heading, clear of the fixed\n     phone bar; desktop keeps a little air above it. */\n  scroll-margin-top: calc(var(--head-bar-height, 0px) + 2.4rem);\n}\n\n/* Discourse comments iframe */\n#discourse-comments iframe {\n  display: block;\n  width: 100%;\n  border: 0;\n  border-radius: var(--border-radius);\n  background: var(--color-bg-alt);\n}\n\n.white {\n  color: var(--color-white);\n}\n\n.gh-card-header h3 {\n  padding-bottom: 1rem;\n}\n\n#gh-head .nav li,\n.is-head-open #gh-head .nav li {\n  transform: none;\n}\n\nblockquote.twitter-tweet {\n  font-size: 133%;\n  max-width: 777px;\n}\n\n.comunidad-comments {\n  margin-bottom: 0;\n}\n\n.gh-main {\n  padding-block: 5rem 6rem;\n}\n\n@media screen and (max-width: 767px) {\n  .gh-topic-content {\n    display: inherit;\n  }\n\n  .gh-card.post {\n    padding-top: 2.33rem;\n    padding-bottom: 2.33rem;\n  }\n}\n\n@media screen and (min-width: 768px) {\n  .gh-topic-content {\n    display: grid;\n  }\n}\n\n.gh-topic-content {\n  row-gap: 3.33rem;\n  column-gap: 2.22rem;\n}\n\n.gh-topic-list .gh-topic-minimal .gh-topic-content {\n  display: unset !important;\n}\n\n@media screen and (max-width: 767px) {\n  .gh-main {\n    padding-block: 5rem;\n  }\n}\n\n.gh-pagehead hr {\n  margin-bottom: 7.11rem;\n}\n\nhtml[data-theme=\"dark\"] hr {\n  opacity: 33% !important;\n}\n\n.nav-icons {\n  align-content: center;\n  align-items: center;\n  align-self: center;\n  display: flex;\n}\n\n.kg-embed-card {\n  max-width: 63rem;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n/* padding on lists */\n.gh-content li+li {\n  padding-top: 1.83rem;\n}\n\n.gh-content li {\n  font-family: var(--font-serif);\n}\n\n/* search aligned */\n@media screen and (min-width: 640px) {\n  .sm\\:max-w-lg {\n    max-width: 60rem !important;\n  }\n}\n\n/* texts by matenauta */\n\nbody:not(.is-dropdown-loaded) .gh-head-menu .nav>li {\n  opacity: inherit;\n}\n\n@media screen and (max-width: 767px) {\n  html {\n    font-size: 63% !important;\n  }\n}\n\na {\n  color: var(--color-base);\n}\n\n.is-head-open #gh-head .gh-head-actions {\n  background-color: unset !important;\n  padding: 0;\n}\n\n.gh-site {\n  min-height: auto !important;\n}\n\n.gh-outer {\n  padding-left: 1.33rem;\n  padding-right: 1.33rem;\n}\n\n@media screen and (min-width: 992px) {\n  .gh-foot .gh-outer {\n    max-width: 80%;\n    margin: auto;\n  }\n}\n\n.is-head-open html {\n  overflow: hidden !important;\n}\n\n.kg-callout-card div.kg-callout-text {\n  line-height: 1.6rem;\n}\n\n.kg-product-card .kg-product-card-description li+li,\n.kg-toggle-card li+li {\n  margin-top: 1.5rem;\n}\n\n.gh-post-upgrade-cta {\n  align-items: inherit;\n}\n\n.gh-post-upgrade-cta-content {\n  padding: 0 !important;\n  background-color: transparent !important;\n}\n\n.gh-post-upgrade-cta a,\n.gh-post-upgrade-cta a:hover {\n  color: inherit !important;\n}\n\n.gh-content>blockquote {\n  margin-bottom: 2rem;\n}\n\n/* Every quote in the text, plain or inside an HTML card (/curso's\n   .cn-voces brings its own sans): the text's serif, upright, at the text's\n   size, after the shape violet bar. Upright is the informative quote;\n   italics (set in the editor) and quotation marks make a literal one. The\n   pulled quote (kg-blockquote-alt) and embedded tweets keep theirs. */\n.gh-content blockquote:not(.kg-blockquote-alt, .twitter-tweet) {\n  padding: 0 0 0 2rem;\n  border-left: 4px solid var(--cn-violeta-tinta-formas);\n  font-family: var(--font-serif);\n  font-size: 1.7rem;\n  font-style: normal;\n  line-height: 1.6;\n}\n\n@media screen and (max-width: 767px) {\n  .gh-content blockquote:not(.kg-blockquote-alt, .twitter-tweet) {\n    font-size: 1.73rem;\n  }\n}\n\n@media screen and (min-width: 768px) and (max-width: 1024px) {\n  .gh-content blockquote:not(.kg-blockquote-alt, .twitter-tweet) {\n    font-size: 2rem;\n  }\n}\n\n.kg-toggle-content {\n  padding: 0 2rem 3rem !important;\n}\n\n.kg-toggle-heading {\n  padding: 2.5rem 2rem;\n  justify-content: space-between !important;\n  align-items: center !important;\n}\n\n/* Ghost's toggle cards as the landing's questions on phones (landing.css):\n   a soft card, no line, rounder corners; light and dark from --cn-ui-soft. */\n.kg-toggle-card {\n  padding: 0 !important;\n  border-radius: 1.2rem !important;\n  background: var(--cn-ui-soft) !important;\n  box-shadow: none !important;\n}\n\n.kg-toggle-card + .kg-toggle-card {\n  margin-top: 0.8rem;\n}\n\n.gh-content h3 {\n  font-weight: 700;\n  font-size: 2.13rem;\n}\n\n/* Tablets set the text at 2rem: the same two steps from there. */\n@media screen and (min-width: 768px) and (max-width: 1024px) {\n  .gh-content h2 {\n    font-size: 3.13rem;\n  }\n\n  .gh-content h3 {\n    font-size: 2.5rem;\n  }\n}\n\n/* The reading measure: text, lists, quotes and headings in a column of about\n   36em of the text (61rem, ~70 characters), centred in the 800px one; images,\n   galleries, tables and HTML cards keep the full 800px. rem, not em: a\n   heading's own em is larger and would widen its column. */\n.gh-content.gh-canvas > :is(p, ul, ol, dl, blockquote, h2, h3, h4, h5, h6, .kg-callout-card, .kg-toggle-card) {\n  width: 100%;\n  max-width: 61rem;\n  margin-inline: auto;\n}\n\n@media screen and (max-width: 767px) {\n  .kg-bookmark-card .kg-bookmark-content {\n    padding: 1.77rem;\n  }\n\n  .kg-bookmark-title {\n    line-height: 1.3rem;\n  }\n}\n\n@media screen and (min-width: 768px) and (max-width: 991px) {\n\n  .gh-content>blockquote:not([class]),\n  .gh-content>dl,\n  .gh-content>ol,\n  .gh-content>ul {\n    margin-bottom: 1rem;\n  }\n\n  .is-head-open .gh-head-brand-wrapper {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .is-head-open #gh-head .gh-head-actions,\n  .is-head-open #gh-head .gh-head-menu {\n    opacity: 1;\n    position: static;\n    visibility: visible;\n  }\n}\n\n/* Author block */\n.gh-autho