  font-size: 1.6rem !important;\n  font-weight: 700;\n  padding-bottom: 0.7rem;\n}\n\n/* A link card leaves the site: the external-link mark in its top right\n   corner, over the text (the picture is above it on phones). */\n.gh-content .kg-bookmark-content {\n  position: relative;\n  padding-right: 4.4rem;\n}\n\n.gh-content .kg-bookmark-content::after {\n  position: absolute;\n  top: 2rem;\n  right: 2rem;\n  width: 1.6rem;\n  height: 1.6rem;\n  content: \"\";\n  background-color: var(--color-secondary-text);\n  mask: var(--gh-ext-icon) center / contain no-repeat;\n}\n\n/* A link's preview image whole, never cropped: link images are mostly\n   1.91:1 social cards with a logo or a title in the middle, wider than the\n   box beside the text. What is left of the box is a soft band. */\n.kg-bookmark-thumbnail {\n  background-color: color-mix(in srgb, var(--color-base) 4%, var(--color-bg));\n}\n\n.gh-content .kg-bookmark-thumbnail img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n/* Phones: beside the text the box is a narrow strip, and a whole wide image\n   in it is tiny. The image goes above the text, full width, at its own\n   1.91:1. */\n@media screen and (max-width: 767px) {\n  .gh-content .kg-bookmark-container {\n    flex-direction: column-reverse;\n  }\n\n  .gh-content .kg-bookmark-thumbnail {\n    flex-basis: auto;\n    width: 100%;\n    max-height: none;\n    aspect-ratio: 1.91;\n  }\n}\n\n.gh-input.focus,\n.gh-input:focus,\n.gh-select:focus,\nselect:focus,\ntextarea:focus {\n  border-color: var(--color-primary);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);\n  outline: 0;\n}\n\n.center {\n  text-align: center;\n}\n\nblockquote.kg-blockquote-alt {\n  font-weight: 500;\n  line-height: 1.83;\n  font-family: var(--font-serif);\n  font-style: italic;\n  margin-top: 5rem;\n  font-size: 2.23rem;\n}\n\n@media screen and (min-width: 768px) and (max-width: 991px) {\n  .kg-image-card {\n    max-width: 90%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n}\n\n.gh-content>ol {\n  font-size: inherit;\n}\n\n.kg-card .kg-bookmark-card {\n  box-shadow: var(--cn-shadow);\n  padding-top: 1.8rem;\n  margin-bottom: 1.8rem;\n}\n\n/* Bookmark card padding. Vertical padding trimmed with the description clamp\n   above, for roughly 20% off the card's height. */\n.kg-bookmark-content {\n  padding: 1.05rem 1.7rem;\n}\n\n/* Bookmark hover */\n.kg-bookmark-container {\n  opacity: 0.78;\n  transition: opacity 0.2s var(--animation-base), box-shadow 0.2s var(--animation-base);\n}\n\n.kg-bookmark-container:hover {\n  opacity: 1;\n  box-shadow: var(--cn-shadow-raised);\n}\n\n.kg-toggle-heading-text {\n  font-size: 2.5rem !important;\n  margin: 0;\n  padding: 0;\n}\n\n.kg-toggle-card-icon,\n.kg-toggle-card[data-kg-toggle-state=\"close\"] svg {\n  cursor: pointer;\n}\n\n.kg-toggle-card[data-kg-toggle-state=\"close\"] .kg-toggle-content {\n  padding: 0 !important;\n}\n\n.kg-toggle-heading svg {\n  width: 1.5rem !important;\n  opacity: 0.6;\n}\n\n.kg-toggle-heading path {\n  stroke-width: 3.33 !important;\n}\n\n.kg-header-card.kg-size-small h2.kg-header-card-header {\n  font-size: 3.33rem;\n}\n\n@media screen and (max-width: 991px) {\n  .gh-head-logo {\n    display: none;\n  }\n\n  .is-head-open .gh-head-logo {\n    display: flex;\n  }\n\n  blockquote.kg-blockquote-alt {\n    line-height: 1.63;\n  }\n}\n\n.kg-toggle-card,\n.kg-toggle-card * {\n  color: var(--color-base);\n}\n\n.home-template #ghost-portal-root {\n  display: none;\n}\n\n:root {\n  --darkreader-inline-color: var (--color-primary);\n}\n\n.gh-portal-powered {\n  display: none;\n}\n\n.gh-portal-btn .gh-portal-btn-link {\n  border: 0;\n}\n\ncode {\n  color: var(--color-base);\n  font-size: 1.5rem;\n}\n\nhtml[data-theme=\"dark\"] code {\n  color: var(--color-bg);\n}\n\n*,\n::after,\n::before {\n  border: 0 solid #e5e7eb;\n}\n\nol>li>ol {\n  list-style-type: lower-alpha;\n}\n\n.is-head-b--a_n .gh-head-menu {\n  justify-content: center;