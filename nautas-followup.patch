th: 768px) and (max-width: 991px) {\n  .gh-article-excerpt {\n    font-size: 2rem !important;\n  }\n}\n\n.error-center {\n  text-align: center;\n  padding-bottom: 6rem;\n}\n\n.gh-inner {\n  max-width: 1500px;\n}\n\n.gh-article-excerpt {\n  font-size: 2rem;\n  padding: 0 0.5rem;\n  margin-top: 0;\n}\n\n@media screen and (min-width: 1500px) {\n\n  .home-template .gh-main a,\n  .gh-topic-grid .gh-card-link,\n  .gh-post-upgrade-cta {\n    opacity: 0.63;\n  }\n\n  .home-template .gh-main a:hover,\n  .gh-topic-grid .gh-card-link a:hover {\n    opacity: 1;\n  }\n}\n\n@media screen and (min-width: 768px) and (max-width: 1249px) {\n  .gh-head-actions {\n    display: unset !important;\n  }\n}\n\n@media screen and (max-width: 1249px) {\n  .home-template .gh-main a {\n    opacity: 1;\n  }\n\n  .home-template .gh-main a:hover {\n    opacity: 77;\n  }\n}\n\n.gh-content>.kg-card+[id] {\n  padding-bottom: 2rem;\n}\n\n.toc-list {\n  margin: 0;\n  padding: 0;\n}\n\n.toc-list-item {\n  list-style-type: none;\n}\n\n/* Desktop TOC column */\n@media screen and (min-width: 992px) {\n  .gh-full-content {\n    gap: var(--toc-gap);\n    align-items: flex-start;\n/* TOC padding */\n    padding-inline: 1.33rem;\n  }\n\n  .gh-sidebar {\n    position: sticky;\n    top: 2.23rem;\n    align-self: flex-start;\n    flex: 0 0 var(--toc-width);\n    min-width: 0;\n    max-height: calc(100vh - 4.5rem);\n    padding-right: 1.77rem;\n    /* A long TOC scrolls inside the column instead of spilling out of it,\n       so the column leaves with the article and never covers the comments. */\n    display: flex;\n    flex-direction: column;\n  }\n\n  .gh-sidebar > * {\n    flex: none;\n  }\n\n  .gh-sidebar .toc {\n    flex: 0 1 auto;\n    min-height: 0;\n  }\n}\n\n@media screen and (min-width: 1090px) {\n  .kg-width-full img {\n    width: 90%;\n  }\n}\n\n@media screen and (min-width: 992px) and (max-width: 1249px) {\n  .gh-head-actions {\n    height: 6rem;\n  }\n}\n\n.gh-head-actions {\n  align-items: inherit;\