eturn;\n        }\n        form.classList.add('is-sending');\n        status.textContent = form.dataset.sending;\n\n        (fields.shot.checked ? screenshot() : Promise.resolve('')).then(function (image) {\n            return fetch(root.dataset.webhook, {\n                method: 'POST',\n                headers: {'Content-Type': 'application/json'},\n                body: JSON.stringify({\n                    type: fields.type.value,\n                    message: fields.message.value,\n                    email: fields.email.value,\n                    website: fields.website.value,\n                    page: location.href,\n                    screenshot: image\n                })\n            });\n        }).then(function (response) {\n            if (!response.ok) {\n                throw new Error(response.status);\n            }\n            form.reset();\n            status.textContent = form.dataset.thanks;\n        }).catch(function () {\n            status.textContent = form.dataset.error;\n        }).then(function () {\n            form.classList.remove('is-sending');\n        });\n    });\n})();\n","/* A forum post's HTML (Discourse \"cooked\"), rebuilt for the page: the\n * search reader (search-modal.js, outside the bundle) and the community\n * topic dialog (community-sidebar.js) both show one. Ships inside\n * main.min.js, which loads before search-modal.js.\n *\n * NautasForumHTML.render(html, origin, emojiClass) returns a <div>; origin\n * resolves the forum's relative links and emoji, emojiClass styles emoji.\n * A quote that opens with [!type] (the forum's callouts, as on GitHub)\n * becomes an <aside class=\"forum-callout\" data-callout=\"type\">. */\nwindow.NautasForumHTML = (function () {\n    /* A forum post is user input: only these tags are rebuilt, with no\n     * attributes but a link's href and an emoji's src/alt. Anything else is\n     * dropped (DROP) or replaced by its children. DOMParser never runs what it parses. */\n    var KEEP = /^(P|BR|HR|UL|OL|LI|BLOCKQUOTE|STRONG|B|EM|I|S|CODE|PRE|H[1-6]|TABLE|THEAD|TBODY|TR|TH|TD|DETAILS|SUMMARY)$/;\n    var DROP = /^(SCRIPT|STYLE|SVG|IFRAME|VIDEO|AUDIO|INPUT|BUTTON|FORM|NOSCRIPT)$/;\n    /* \"> [!tldr] Title\" arrives as a blockquote whose first paragraph starts\n     * with the marker; the rest of that line is the title, else the type.\n     * Folding (+/-) is dropped: the callout shows open. */\n    var callout = function (quote) {\n        var first = quote.tagName === 'BLOCKQUOTE' && quote.firstElementChild;\n        var text = first && first.tagName === 'P' && first.firstChild;\n        var m = text && text.nodeType === 3 && /^\\s*\\[!([a-z]+)\\][+-]?\\s*/i.exec(text.nodeValue);\n        if (!m) {\n            return quote;\n        }\n        var type = m[1].toLowerCase();\n        var box = document.createElement('aside');\n        box.className = 'forum-callout';\n        box.setAttribute('data-callout', type);\n        text.nodeValue = text.nodeValue.slice(m[0].length);\n        first.className = 'forum-callout-title';\n        if (!first.textContent.trim()) {\n            first.textContent = type.charAt(0).toUpperCase() + type.slice(1);\n        }\n        while (quote.firstChild) {\n            box.appendChild(quote.firstChild);\n        }\n        return box;\n    };\n\n    var clean = function (from, to, origin, emojiClass) {\n        Array.prototype.forEach.call(from.childNodes, function (node) {\n            if (node.nodeType === 3) {\n                to.appendChild(document.createTextNode(node.nodeValue));\n                return;\n            }\n            if (node.nodeType !== 1 || DROP.test(node.tagName)) {\n                return;\n            }\n            var url = function (value) {\n                try {\n                    var u = new URL(value, origin);\n                    return /^https?:$/.test(u.protocol) ? u.href : '';\n                } catch (e) {\n                    return '';\n                }\n            };\n            var out = null;\n            if (node.tagName === 'IMG') {\n                // Emoji only: uploads and avatars would need their own layout.\n                if (node.classList.contains('emoji') && url(node.getAttribute('src'))) {\n                    out = document.createElement('img');\n                    out.className = emojiClass;\n                    out.src = url(node.getAttribute('src'));\n                    out.alt = node.getAttribute('alt') || '';\n                    to.appendChild(out);\n                }\n                return;\n            }\n            // A link preview becomes its link.\n            if (node.tagName === 'ASIDE') {\n                var src = url(node.getAttribute('data-onebox-src') || '');\n                if (src) {\n                    var p = document.createElement('p');\n                    var a = document.createElement('a');\n                    a.href = a.textContent = src;\n                    a.target = '_blank';\n                    a.rel = 'noopener';\n                    p.appendChild(a);\n                    to.appendChild(p);\n                }\n                return;\n            }\n            if (node.tagName === 'A') {\n                // Heading anchors are empty; image lightboxes carry only a file name.\n                if (node.classList.contains('anchor') || node.classList.contains('lightbox')) {\n                    return;\n                }\n                out = document.createElement('a');\n                var href = url(node.getAttribute('href') || '');\n                if (href) {\n                    out.href = href;\n                    out.target = '_blank';\n                    out.rel = 'noopener';\n                }\n            } else if (KEEP.test(node.tagName)) {\n                out = document.createElement(node.tagName);\n            }\n            clean(node, out || to, origin, emojiClass);\n            if (out) {\n                to.appendChild(callout(out));\n            }\n        });\n        return to;\n    };\n\n    return {\n        render: function (html, origin, emojiClass) {\n            var doc = new DOMParser().parseFromString(String(html || ''), 'text/html');\n            return clean(doc.body, document.createElement('div'), origin, emojiClass);\n        }\n    };\n})();\n","/* Glossary in posts: the first time one of the forum glossary's terms\n * tagged blog-glosario appears in the text it gets a faint dotted underline,\n * and tapping it shows the definition in a small card, with the way to the\n * full entry. Up to MAX terms in a beginner post (#nivel-1), fewer in the\n * rest, and none in headings, links, code, captions, quotes or cards. Ships\n * inside main.min.js.\n *\n * The terms are the forum's: its public search for the tag gives each\n * topic's id and title, and the title gives the ways to write it\n * (\"KYC / Know Your Costumer\", \"Tor (The Onion Router)\"), plus a plural; a few\n * Spanish forms the titles lack are added below. Tagging or untagging a topic\n * in the forum adds or drops a term. The definition is the topic's first\n * paragraph, fetched when first asked for and set as plain text. If either\n * does not load, the post stays as it is, or the card keeps the term and the\n * link.\n */\n(function () {\n    var ORIGIN = (document.documentElement.getAttribute('data-discourse') || '').replace(/\\/+$/, '');\n    var content = document.querySelector('.gh-content');\n\n    if (!ORIGIN || !content || !document.body.classList.contains('post-template') || !window.fetch) {\n        return;\n    }\n\n    var MAX = document.body.classList.contains('tag-hash-nivel-1') ? 5 : 3;\n    var LANG = document.documentElement.lang || 'es';\n\n    // Forms the forum titles lack (topic id: forms).\n    var EXTRA = {\n        2445: ['billetera'],\n        2425: ['clave privada', 'claves privadas'],\n        2401: ['fiat'],\n        2383: ['cadena de bloques'],\n        2382: ['mercado bajista'],\n        2386: ['bull run', 'bull market', 'mercado alcista'],\n        2381: ['máximo histórico'],\n        2416: ['market cap'],\n        2430: ['Satoshi'],\n        2400: ['comisiones'],\n        2390: ['almacenamiento en frío'],\n        6506: ['ciclos de mercado']\n    };\n\n    var formsOf = function (id, title) {\n        var inside = (title.match(/\\(([^)]*)\\)/) || [])[1] || '';\n        var parts = title.replace(/\\([^)]*\\)/g, '').split('/').concat(inside.split('/'));\n        return parts.concat(EXTRA[id] || []).map(function (part) {\n            return part.trim();\n        }).filter(function (part) {\n            return part.length > 1;\n        });\n    };\n\n    // shortcut: search answers up to 50 topics; page it if the tag grows past that.\n    var terms = function () {\n        return fetch(ORIGIN + '/search.json?q=' + encodeURIComponent('tags:blog-glosario'), {\n            credentials: 'omit',\n            headers: {Accept: 'application/json', 'Accept-Language': LANG}\n        }).then(function (response) {\n            return response.ok ? response.json() : Promise.reject(new Error(response.status));\n        }).then(function (found) {\n            var list = {};\n            ((found && found.topics) || []).forEach(function (topic) {\n                var id = parseInt(topic.id, 10);\n                if (id > 0 && topic.title) {\n                    list[id] = formsOf(id, String(topic.title));\n                }\n            });\n            return list;\n        });\n    };\n\n    var start = function (TERMS) {\n        var escape = function (text) {\n            return text.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&').replace(/[-\\s]+/g, '[-\\\\s]+');\n        };\n        var entries = Object.keys(TERMS).map(function (id) {\n            // Longest form first, so \"clave privada\" wins over a shorter one.\n            var forms = TERMS[id].slice().sort(function (a, b) {\n                return b.length - a.length;\n            });\n            // Upper-case forms (KYC, ATH) only as written; the rest in any case.\n            var exact = forms.filter(function (form) {\n                return form === form.toUpperCase();\n            });\n            var loose = forms.filter(function (form) {\n                return form !== form.toUpperCase();\n            });\n            var edge = function (list, flags) {\n                // A plural too (wallets, exchanges): any form ending in a letter.\n                return list.length ? new RegExp('(?<![\\\\p{L}\\\\p{N}])(?:' + list.map(escape).join('|') + ')(?:e?s)?(?![\\\\p{L}\\\\p{N}])', flags) : null;\n            };\n            return {id: id, exact: edge(exact, 'u'), loose: edge(loose, 'iu')};\n        });\n\n        var SKIP = 'a, h1, h2, h3, h4, h5, h6, code, pre, button, figcaption, blockquote, .kg-card, .cn-term, script, style';\n\n        var walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT, {\n            acceptNode: function (node) {\n                return node.parentElement.closest(SKIP) || !node.nodeValue.trim()\n                    ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;\n            }\n        });\n        var nodes = [];\n        while (walker.nextNode()) {\n            nodes.push(walker.currentNode);\n        }\n\n        var marked = 0;\n        var used = {};\n        for (var n = 0; n < nodes.length && marked < MAX; n++) {\n            var node = nodes[n];\n            // A node can hold several terms: keep looking in what follows a mark.\n            while (node && marked < MAX) {\n                var best = null;\n                entries.forEach(function (entry) {\n                    if (used[entry.id]) {\n                        return;\n                    }\n                    [entry.exact, entry.loose].forEach(function (re) {\n                        var found = re && re.exec(node.nodeValue);\n                        // Earliest wins; at the same place the longer (\"Satoshi Nakamoto\").\n                        if (found && (!best || found.index < best.index || (found.index === best.index && found[0].length > best.text.length))) {\n                            best = {index: found.index, text: found[0], id: entry.id};\n                        }\n                    });\n                });\n                if (!best) {\n                    break;\n                }\n                used[best.id] = true;\n                marked++;\n                var rest = node.splitText(best.index);\n                node = rest.splitText(best.text.length);\n                var term = document.createElement('button');\n                term.type = 'button';\n                term.className = 'cn-term';\n                term.setAttribute('data-topic', best.id);\n                term.setAttribute('aria-expanded', 'false');\n                term.textContent = best.text;\n                rest.replaceWith(term);\n            }\n        }\n\n        if (!marked) {\n            return;\n        }\n\n        // One card for every term, placed under the one tapped.\n        var card = document.createElement('div');\n        card.className = 'cn-term-card';\n        card.hidden = true;\n        card.setAttribute('role', 'dialog');\n        var title = document.createElement('strong');\n        var text = document.createElement('p');\n        var more = document.createElement('a');\n        more.target = '_blank';\n        more.rel = 'noopener';\n        more.textContent = document.documentElement.getAttribute('lang') === 'es' ? 'ver en el glosario ↗' : 'see in the glossary ↗';\n        card.append(title, text, more);\n        document.body.appendChild(card);\n\n        var cache = {};\n        var open = null;\n\n        var definition = function (id) {\n            if (!cache[id]) {\n                // In the site's language: the forum answers in the browser's\n                // otherwise, and serves its machine translation to the rest.\n                cache[id] = fetch(ORIGIN + '/t/' + id + '.json', {\n                    credentials: 'omit',\n                    headers: {Accept: 'application/json', 'Accept-Language': document.documentElement.lang || 'es'}\n                })\n                    .then(function (response) {\n                        return response.ok ? response.json() : Promise.reject(new Error(response.status));\n                    })\n                    .then(function (topic) {\n                        var first = topic.post_stream && topic.post_stream.posts && topic.post_stream.posts[0];\n                        var doc = new DOMParser().parseFromString((first && first.cooked) || '', 'text/html');\n                        var para = Array.prototype.find.call(doc.querySelectorAll('p'), function (p) {\n                            return p.textContent.trim().length > 40 && /[a-zá-ú]/.test(p.textContent);\n                        });\n                        return {title: String(topic.title || ''), text: para ? para.textContent.trim() : ''};\n                    });\n                cache[id].then(null, function () {\n                    delete cache[id];\n                });\n            }\n            return cache[id];\n        };\n\n        var close = function () {\n            if (open) {\n                open.setAttribute('aria-expanded', 'false');\n                open = null;\n            }\n            card.hidden = true;\n        };\n\n        var place = function (term) {\n            var box = term.getBoundingClientRect();\n            var width = Math.min(320, document.documentElement.clientWidth - 32);\n            var left = Math.max(16, Math.min(box.left + window.scrollX, window.scrollX + document.documentElement.clientWidth - width - 16));\n            card.style.width = width + 'px';\n            card.style.left = left + 'px';\n            card.style.top = (box.bottom + window.scrollY + 8) + 'px';\n        };\n\n        content.addEventListener('click', function (event) {\n            var term = event.target.closest('.cn-term');\n            if (!term) {\n                return;\n            }\n            if (open === term) {\n                close();\n                return;\n            }\n            close();\n            open = term;\n            term.setAttribute('aria-expanded', 'true');\n            var id = term.getAttribute('data-topic');\n            title.textContent = term.textContent;\n            text.textContent = '…';\n            more.href = ORIGIN + '/t/' + id;\n            card.hidden = false;\n            place(term);\n            definition(id).then(function (found) {\n                if (open === term) {\n                    title.textContent = found.title || term.textContent;\n                    text.textContent = found.text;\n                    text.hidden = !found.text;\n                }\n            }, function () {\n                if (open === term) {\n                    text.hidden = true;\n                }\n            });\n        });\n\n        document.addEventListener('click', function (event) {\n            if (open && !event.target.closest('.cn-term, .cn-term-card')) {\n                close();\n            }\n        });\n        document.addEventListener('keydown', function (event) {\n            if (event.key === 'Escape' && open) {\n                var term = open;\n                close();\n                term.focus();\n            }\n        });\n        window.addEventListener('resize', close);\n        // Images above that finish loading move the term: the card follows it.\n        if (window.ResizeObserver) {\n            new ResizeObserver(function () {\n                if (open) {\n                    place(open);\n                }\n            }).observe(content);\n        }\n    };\n\n    terms().then(start, function () {});\n})();\n","/* Tablet/mobile header bar behaviour.\n * Ships inside main.min.js.\n */\n(function () {\n    /* 1. Search field. The bar has a real input, but results live in the\n     *    search modal, so the first keystroke hands the text over and the\n     *    modal takes focus - one search UI, not two. window.nautasSearch is\n     *    defined by assets/js/search-modal.js, which loads deferred and so\n     *    runs after this bundle; until then, clicking the modal's own trigger\n     *    is the fallback.\n     */\n    var form = document.querySelector('.gh-head-search-field');\n    var input = form && form.querySelector('input');\n\n    if (input) {\n        var handOff = function () {\n            var query = input.value;\n            input.value = '';\n            input.blur();\n\n            if (window.nautasSearch && typeof window.nautasSearch.open === 'function') {\n                window.nautasSearch.open(query);\n                return;\n            }\n\n            var trigger = document.querySelector('[data-ghost-search]');\n            if (trigger) {\n                trigger.click();\n            }\n        };\n\n        input.addEventListener('input', handOff);\n        // A tap alone opens the modal too, so its common searches show before\n        // anything is typed; it is a user gesture, so mobile keeps the keyboard up.\n        input.addEventListener('click', handOff);\n        form.addEventListener('submit', function (event) {\n            event.preventDefault();\n            handOff();\n        });\n    }\n\n    /* 1b. Desktop search bar: name the shortcut the modal answers to on this\n     *     platform (it takes both Cmd and Ctrl). */\n    var key = document.querySelector('.gh-search-bar-key');\n    if (key) {\n        key.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K';\n        key.hidden = false;\n    }\n\n    /* 2. Bar position. Up to 991px the bar is fixed to the viewport (header\n     *    block in screen.css). Ghost renders its announcement bar above\n     *    .gh-site, so a bar pinned at top:0 covered it. --head-top follows the\n     *    bottom edge of whatever sits above .gh-site until it scrolls away,\n     *    then stays at 0. Unused on desktop, where the header is not fixed.\n     */\n    var site = document.querySelector('.gh-site');\n\n    if (site) {\n        var root = document.documentElement;\n        var queued = false;\n\n        var place = function () {\n            queued = false;\n            root.style.setProperty('--head-top', Math.max(0, site.getBoundingClientRect().top) + 'px');\n        };\n\n        var schedule = function () {\n            if (!queued) {\n                queued = true;\n                window.requestAnimationFrame(place);\n            }\n        };\n\n        place();\n        window.addEventListener('scroll', schedule, {passive: true});\n        window.addEventListener('resize', schedule);\n\n        // The announcement bar is injected by Ghost's own script, after this runs.\n        if ('ResizeObserver' in window) {\n            new ResizeObserver(schedule).observe(document.body);\n        }\n    }\n\n    /* 3. Hide-on-scroll for the fixed bar. Only up to 991px: that is where\n     *    #gh-head is position: fixed, so there is something to hide. On\n     *    desktop the header is static and scrolls away by itself.\n     *\n     *    Down past the first 64px hides it (.is-unpinned, screen.css); up by\n     *    more than 5px, or back near the top, shows it again - the small\n     *    tolerance keeps a stray pixel from flapping it. Overscroll (iOS\n     *    bounce, past either end) is ignored. headroom.js did this before.\n     *\n     * 4. Past the end of a post - its comments and the forum cards - the\n     *    header comes back and stays (.is-docked), with the search and the\n     *    menu at hand to go on. On desktop, where it is static, it is fixed\n     *    to the top then; .gh-site takes its height as padding, so nothing\n     *    under the reader moves.\n     */\n    var head = document.getElementById('gh-head');\n    var bar = window.matchMedia('(max-width: 991px)');\n\n    var article = document.querySelector('.post-template .gh-article');\n\n    var dock = function (on) {\n        if (on === head.classList.contains('is-docked')) {\n            return;\n        }\n        if (site && !bar.matches) {\n            site.style.paddingTop = on ? head.offsetHeight + 'px' : '';\n        }\n        head.classList.toggle('is-docked', on);\n    };\n\n    if (head) {\n        var OFFSET = 64;\n        var TOLERANCE_UP = 5;\n        var lastY = window.scrollY;\n        var ticking = false;\n\n        var update = function () {\n            ticking = false;\n            var y = Math.round(window.scrollY);\n            var max = document.documentElement.scrollHeight - window.innerHeight;\n            if (y < 0 || y > max) {\n                lastY = y;\n                return;\n            }\n            var docked = !!article && article.getBoundingClientRect().bottom < window.innerHeight;\n            dock(docked);\n            if (!bar.matches) {\n                lastY = y;\n                return;\n            }\n            if (docked || y <= OFFSET || lastY - y > TOLERANCE_UP) {\n                head.classList.remove('is-unpinned');\n            } else if (y > lastY) {\n                head.classList.add('is-unpinned');\n            }\n            lastY = y;\n        };\n\n        window.addEventListener('scroll', function () {\n            if (!ticking) {\n                ticking = true;\n                window.requestAnimationFrame(update);\n            }\n        }, {passive: true});\n\n        // Closing the phone menu puts the page back with scrollTo, which read\n        // as a scroll down and hid the bar. Shown instead, with search and the\n        // blog link at hand, until the reader scrolls again. The observer runs\n        // after that scrollTo, so lastY is already the restored position.\n        var menuOpen = document.body.classList.contains('is-head-open');\n        new MutationObserver(function () {\n            var open = document.body.classList.contains('is-head-open');\n            if (menuOpen && !open) {\n                head.classList.remove('is-unpinned');\n                lastY = Math.round(window.scrollY);\n            }\n            menuOpen = open;\n        }).observe(document.body, {attributes: true, attributeFilter: ['class']});\n\n        // Back to desktop: nothing to hide.\n        bar.addEventListener('change', function () {\n            dock(false);\n            head.classList.remove('is-unpinned');\n            lastY = window.scrollY;\n        });\n    }\n\n})();\n","/* Landing (partials/landing.hbs): the page \"inicio\" arrives as one run of\n * paragraphs and h3 questions. Each question and its answer become one item,\n * two across from 992px (landing.css), read left to right; the last question -\n * how to go on - steps out of the grid, full width and one heading level up\n * (h2), to lead into the three cards. The opening line goes up into the first screen. Without this\n * script the text reads as one column, opening line first. Ships inside\n * main.min.js.\n */\n(function () {\n    var box = document.querySelector('.gh-landing-text .gh-content');\n    var questions = box ? box.querySelectorAll(':scope > h3') : [];\n\n    if (questions.length < 2) {\n        return;\n    }\n\n    var grid = document.createElement('div');\n    grid.className = 'gh-landing-faq';\n    var next = document.createElement('div');\n    next.className = 'gh-landing-next';\n    var last = questions[questions.length - 1];\n\n    Array.prototype.forEach.call(questions, function (question) {\n        var group = [question];\n        for (var el = question.nextElementSibling; el && el.tagName !== 'H3'; el = el.nextElementSibling) {\n            group.push(el);\n        }\n        var item = question === last ? next : document.createElement('div');\n        if (question !== last) {\n            item.className = 'gh-landing-faq-item';\n            grid.appendChild(item);\n        }\n        group.forEach(function (node) {\n            item.appendChild(node);\n        });\n    });\n\n    // What came before the first question - the opening line - moves up into\n    // the first screen, under the compact ways in; the groups follow.\n    var intro = document.querySelector('.gh-landing-intro');\n    while (intro && box.firstElementChild && box.firstElementChild !== questions[0]) {\n        intro.appendChild(box.firstElementChild);\n    }\n    box.appendChild(grid);\n    box.appendChild(next);\n    // The three cards join the heading that leads into them, so one grey band\n    // (landing.css) holds both; the band closes the page after what members\n    // say, in a section of its own that keeps the text setting (.gh-content).\n    var paths = document.querySelector('.gh-landing-paths');\n    if (paths) {\n        next.appendChild(paths);\n    }\n    var voices = document.querySelector('.gh-landing-voices');\n    if (voices) {\n        var way = document.createElement('section');\n        way.className = 'gh-landing-way gh-landing-snap';\n        way.innerHTML = '<div class=\"gh-content gh-landing-inner\"></div>';\n        way.firstChild.appendChild(next);\n        voices.after(way);\n    }\n\n    // Below 992px, one column: each question opens its answer, or the six\n    // answers ran three screens of text. From 992px every answer shows and the\n    // buttons step out of the way.\n    var wide = window.matchMedia('(min-width: 992px)');\n    var toggles = [];\n    Array.prototype.forEach.call(grid.children, function (item, index) {\n        var question = item.firstElementChild;\n        var answer = document.createElement('div');\n        answer.className = 'gh-landing-faq-answer';\n        answer.id = 'gh-landing-faq-' + index;\n        while (question.nextSibling) {\n            answer.appendChild(question.nextSibling);\n        }\n        item.appendChild(answer);\n\n        var toggle = document.createElement('button');\n        toggle.type = 'button';\n        toggle.className = 'gh-landing-faq-toggle';\n        while (question.firstChild) {\n            toggle.appendChild(question.firstChild);\n        }\n        question.appendChild(toggle);\n        toggle.addEventListener('click', function () {\n            if (!wide.matches) {\n                item.classList.toggle('is-open');\n                sync();\n            }\n        });\n        toggles.push(toggle);\n    });\n\n    function sync() {\n        toggles.forEach(function (toggle) {\n            if (wide.matches) {\n                toggle.removeAttribute('aria-expanded');\n                toggle.removeAttribute('aria-controls');\n                toggle.tabIndex = -1;\n            } else {\n                toggle.setAttribute('aria-expanded', String(toggle.closest('.gh-landing-faq-item').classList.contains('is-open')));\n                toggle.setAttribute('aria-controls', toggle.parentNode.nextElementSibling.id);\n                toggle.tabIndex = 0;\n            }\n        });\n    }\n    sync();\n    wide.addEventListener('change', sync);\n\n    var heading = document.createElement('h2');\n    heading.id = last.id;\n    while (last.firstChild) {\n        heading.appendChild(last.firstChild);\n    }\n    last.replaceWith(heading);\n})();\n\n/* What members say: two rows that drift in opposite directions\n * (landing.css). Each row holds its half of the cards twice so the loop has no\n * seam; the copies are hidden from screen readers. With reduced motion the\n * original sideways row stays.\n */\n(function () {\n    var list = document.querySelector('.gh-landing-voices-list');\n    if (!list || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n        return;\n    }\n    var voices = Array.prototype.slice.call(list.children);\n    var half = Math.ceil(voices.length / 2);\n    var marquee = document.createElement('div');\n    marquee.className = 'gh-landing-marquee';\n    marquee.setAttribute('role', 'region');\n    marquee.setAttribute('aria-labelledby', list.getAttribute('aria-labelledby'));\n    [voices.slice(0, half), voices.slice(half)].forEach(function (group, i) {\n        var row = document.createElement('div');\n        row.className = 'gh-landing-marquee-row' + (i ? ' is-reverse' : '');\n        var track = document.createElement('div');\n        track.className = 'gh-landing-marquee-track';\n        group.forEach(function (voice) {\n            track.appendChild(voice);\n        });\n        group.forEach(function (voice) {\n            var copy = voice.cloneNode(true);\n            copy.setAttribute('aria-hidden', 'true');\n            track.appendChild(copy);\n        });\n        row.appendChild(track);\n        marquee.appendChild(row);\n    });\n    list.replaceWith(marquee);\n})();\n","/* /blog level switches (index.hbs): every level on at first; each switch\n * takes its level out of the list or brings it back. Cards carry the class\n * Ghost gives them for their internal tag (tag-hash-nivel-N); the choice is a\n * class per hidden level on the list, so cards that infinite scroll adds later\n * follow it too (screen.css). Posts without a level show only with every level\n * on. The choice is kept in this browser: the hidden levels, nothing else.\n * Ships inside main.min.js.\n */\n(function () {\n    var group = document.querySelector('.gh-levels');\n    var feed = document.querySelector('.gh-feed');\n    var STORE = 'gh-levels-hidden';\n\n    if (!group || !feed) {\n        return;\n    }\n\n    var levels = Array.prototype.slice.call(group.querySelectorAll('[data-level]'));\n\n    // One level alone has nothing to choose between.\n    if (levels.length < 2) {\n        group.hidden = true;\n        return;\n    }\n\n    var known = levels.map(function (pill) {\n        return pill.getAttribute('data-level');\n    });\n\n    var hidden = [];\n    try {\n        hidden = (window.localStorage.getItem(STORE) || '').split(',').filter(function (level) {\n            return known.indexOf(level) !== -1;\n        });\n    } catch (e) {}\n\n    var apply = function () {\n        // A stored choice with every level off (levels came and went).\n        if (hidden.length >= known.length) {\n            hidden = [];\n        }\n        levels.forEach(function (pill) {\n            var level = pill.getAttribute('data-level');\n            var off = hidden.indexOf(level) !== -1;\n            pill.setAttribute('aria-checked', String(!off));\n            feed.classList.toggle('is-hidden-' + level, off);\n        });\n        feed.classList.toggle('is-filtered', hidden.length > 0);\n        try {\n            if (hidden.length) {\n                window.localStorage.setItem(STORE, hidden.join(','));\n            } else {\n                window.localStorage.removeItem(STORE);\n            }\n        } catch (e) {}\n    };\n\n    levels.forEach(function (pill) {\n        pill.addEventListener('click', function () {\n            var level = pill.getAttribute('data-level');\n            var at = hidden.indexOf(level);\n            if (at === -1) {\n                // The last level on stays on: no empty list.\n                if (hidden.length + 1 >= known.length) {\n                    return;\n                }\n                hidden.push(level);\n            } else {\n                hidden.splice(at, 1);\n            }\n            feed.classList.add('is-switched');\n            apply();\n        });\n    });\n\n    apply();\n})();\n","/* Community sidebar mascot (partials/community-sidebar.hbs): anonist sits on\n * the box's top border over the heading and blinks; every 20 s he walks the\n * border, waves or, less often, scratches his head. In the Mask style (.is-mask)\n * only the mask floats over the border: it glides instead of walking, spins\n * instead of waving and winks instead of scratching. Clicks go through the\n * three phrases of the day, one from each list of PHRASES in its order,\n * drawn by the local date: the same for every visitor. Frames are the symbols of\n * assets/images/anonist-sprite.svg, swapped in steps. With reduced motion he\n * stays seated and only answers clicks.\n * Ships inside main.min.js.\n */\n(function () {\n    // Freedom / tech, care (body and mind), community / growth.\n    var PHRASES = [\n        [\n            'use foss', 'use monero', 'do it yourself', 'verify, don\\'t trust', 'own your keys',\n            'run your node', 'stay private', 'encrypt it', 'pay in cash', 'trade p2p',\n            'build in public', 'question everything', 'use tor', 'run linux', 'opt out',\n            'stay sovereign', 'self-host it', 'own your data', 'back up your seed',\n            'mind your opsec', 'keep it local', 'stack monero', 'check the source', 'no kyc'\n        ],\n        [\n            'eat food', 'just breathe', 'look at stars', 'play music', 'enjoy it',\n            'move your body', 'just relax', 'drink water', 'take a walk', 'sleep well',\n            'touch grass', 'cook at home', 'laugh often', 'plant something', 'stretch your body',\n            'be yourself', 'trust yourself', 'sh*t happens', 'here and now', 'be patient',\n            'rest when tired', 'dance a little', 'feel it all', 'forgive yourself'\n        ],\n        [\n            'keep going', 'keep it simple', 'mutual aid', 'be kindly', 'be humble',\n            'start small', 'think big', 'talk about it', 'make it worth', 'trust your guts',\n            'follow your instinct', 'make it real', 'make it happen', 'say it loud',\n            'share your art', 'help someone', 'say thank you', 'stay curious', 'less is more',\n            'learn something', 'listen first', 'stay open', 'be the change', 'give credit'\n        ]\n    ];\n    var STEP = 160;\n    var mascot = document.querySelector('.gh-mascot');\n\n    if (!mascot) {\n        return;\n    }\n\n    var aside = mascot.closest('.gh-community');\n    var title = aside.querySelector('.gh-community-title');\n    var bubble = mascot.querySelector('.gh-mascot-bubble');\n    var use = mascot.querySelector('use');\n    var sprite = use.getAttribute('href').split('#')[0];\n    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var busy = false;\n    var x = 0;\n    var talking;\n    var said = 0;\n    var masked = mascot.classList.contains('is-mask');\n    var REST = masked ? 'mask-idle' : 'sit';\n\n    var show = function (frame) {\n        use.setAttribute('href', sprite + '#anonist-48-' + frame);\n        // Seated frames rest on the border, the others stand on it (community.css).\n        mascot.classList.toggle('is-standing', !/^(sit|scratch)/.test(frame));\n    };\n\n    var place = function (to) {\n        mascot.classList.toggle('is-left', to < x);\n        x = to;\n        mascot.style.transform = 'translateX(' + x + 'px)';\n    };\n\n    // His seat: over the middle of the heading.\n    var home = function () {\n        return Math.round(title.offsetLeft + (title.offsetWidth - mascot.offsetWidth) / 2);\n    };\n\n    // Steps are {frame, x}, one every STEP ms; he sits back down after the last.\n    var play = function (steps) {\n        busy = true;\n        var i = 0;\n        var tick = function () {\n            if (i === steps.length) {\n                show(REST);\n                mascot.classList.remove('is-left');\n                busy = false;\n                return;\n            }\n            show(steps[i].frame);\n            if (steps[i].x !== undefined) {\n                place(steps[i].x);\n            }\n            i += 1;\n            setTimeout(tick, STEP);\n        };\n        tick();\n    };\n\n    var repeat = function (frames, times) {\n        var steps = [];\n        for (var i = 0; i < times; i += 1) {\n            steps.push({frame: frames[i % frames.length]});\n        }\n        return steps;\n    };\n\n    // To the right end, the left end and back to his seat, 8 px a step.\n    var walk = function () {\n        var steps = [];\n        var at = x;\n        [aside.clientWidth - mascot.offsetWidth, 0, home()].forEach(function (to) {\n            while (at !== to) {\n                at += Math.max(-8, Math.min(8, to - at));\n                steps.push({frame: masked ? 'mask-idle' : steps.length % 2 ? 'walk-b' : 'walk-a', x: at});\n            }\n        });\n        return steps;\n    };\n\n    // One phrase from each list for the local date, from a small seeded generator.\n    var today = function () {\n        var seed = Math.floor((Date.now() - new Date().getTimezoneOffset() * 60000) / 864e5);\n        return PHRASES.map(function (list) {\n            seed = (seed * 9301 + 49297) % 233280;\n            return list[seed % list.length];\n        });\n    };\n\n    // One turn of the mask, showing the strap on its back, as on the forum.\n    var wave = masked\n        ? repeat(['mask-idle', 'mask-turn-a', 'mask-side', 'mask-back', 'mask-side', 'mask-turn-b'], 6)\n        : [{frame: 'idle'}].concat(repeat(['salute'], 8), [{frame: 'idle'}]);\n    var scratch = masked ? repeat(['mask-wink'], 6) : repeat(['scratch-a', 'scratch-b'], 10);\n\n    mascot.hidden = false;\n\n    // The aside opens once the forum answers, and its width can change: keep his seat.\n    new ResizeObserver(function () {\n        if (!busy) {\n            place(home());\n            mascot.classList.remove('is-left');\n        }\n    }).observe(aside);\n\n    mascot.querySelector('button').addEventListener('click', function () {\n        bubble.textContent = today()[said % 3];\n        said += 1;\n        // In the right half of the box the balloon opens on his left (community.css).\n        mascot.classList.toggle('is-flipped', x > aside.clientWidth / 2);\n        clearTimeout(talking);\n        // Emptied, the bubble hides (community.css) and the next click is announced again.\n        talking = setTimeout(function () {\n            bubble.textContent = '';\n        }, 3000);\n        if (!busy && !still) {\n            play(wave);\n        }\n    });\n\n    if (still) {\n        return;\n    }\n\n    setInterval(function () {\n        if (busy || aside.hidden) {\n            return;\n        }\n        var roll = Math.random();\n        play(roll < 0.55 ? walk() : roll < 0.85 ? wave : scratch);\n    }, 20000);\n\n    var blink = function () {\n        if (!busy) {\n            play([{frame: masked ? 'mask-blink' : 'sit-blink'}]);\n        }\n        setTimeout(blink, 3000 + Math.random() * 3000);\n    };\n    setTimeout(blink, 3000);\n})();\n","/* Monero tips: the pill at the end of the article (partials/reactions.hbs)\n * and the icon among the author's social links (author.hbs), both opening\n * partials/monero-tip-dialog.hbs. Ships inside main.min.js.\n *\n * The forum's discourse-monero-tips plugin answers /monero-tips/{username}.json\n * with the address, a QR data URL and the monero: link; it 404s while the\n * account has no address, and the button stays hidden. Sent with the forum\n * cookie so a member signed in there gets their own attributed subaddress\n * when the account has verified tips on (same CORS setup as reactions.js).\n *\n * The words follow the browser's language (Spanish or English), not the\n * site's, so they are filled here rather than with {{t}}.\n */\n(function () {\n    // Same forum as the comments embed (discourse-embed.js).\n    var ORIGIN = (document.documentElement.getAttribute('data-discourse') || '').replace(/\\/+$/, '');\n\n    var dialog = document.querySelector('.gh-monero-tip-dialog');\n\n    if (!ORIGIN || !dialog || !window.fetch) {\n        return;\n    }\n\n    // The \"Monero tips username\" setting: the forum account every tip goes to.\n    var USERNAME = encodeURIComponent(dialog.getAttribute('data-username') || '');\n\n    if (!USERNAME) {\n        return;\n    }\n\n    var WORDS = /^es\\b/i.test(navigator.language || '') ? {\n        tips: 'tips en XMR',\n        intro: 'El tip va directo a la wallet del autor.',\n        scan: 'Escanear desde wallet',\n        address: 'Dirección de Monero',\n        copy: 'copiar dirección',\n        copied: 'copiada',\n        wallet: 'abrir en wallet',\n        close: 'cerrar'\n    } : {\n        tips: 'XMR tips',\n        intro: \"The tip goes straight to the author's wallet.\",\n        scan: 'Scan from wallet',\n        address: 'Monero address',\n        copy: 'copy address',\n        copied: 'copied',\n        wallet: 'open in wallet',\n        close: 'close'\n    };\n\n    [['data-i18n', null], ['data-i18n-aria', 'aria-label'], ['data-i18n-alt', 'alt']].forEach(function (pair) {\n        Array.prototype.forEach.call(document.querySelectorAll('[' + pair[0] + ']'), function (el) {\n            var text = WORDS[el.getAttribute(pair[0])];\n            if (pair[1]) {\n                el.setAttribute(pair[1], text);\n            } else {\n                el.textContent = text;\n            }\n        });\n    });\n\n    var input = dialog.querySelector('.gh-monero-tip-address');\n    var copy = dialog.querySelector('.gh-monero-tip-copy');\n\n    fetch(ORIGIN + '/monero-tips/' + USERNAME + '.json', {\n        credentials: 'include',\n        headers: {Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest'}\n    }).then(function (response) {\n        if (!response.ok) {\n            throw new Error(response.status);\n        }\n        return response.json();\n    }).then(function (tip) {\n        input.value = tip.address;\n        dialog.querySelector('.gh-monero-tip-qr').src = tip.qr;\n        dialog.querySelector('.gh-monero-tip-wallet').href = tip.uri;\n        Array.prototype.forEach.call(document.querySelectorAll('[data-monero-tip]'), function (el) {\n            el.hidden = false;\n        });\n    }).catch(function () {});\n\n    Array.prototype.forEach.call(document.querySelectorAll('.gh-monero-tip-open'), function (button) {\n        button.addEventListener('click', function () {\n            if (dialog.showModal) {\n                dialog.showModal();\n            } else {\n                dialog.setAttribute('open', '');\n            }\n        });\n    });\n\n    copy.addEventListener('click', function () {\n        var done = function () {\n            copy.textContent = WORDS.copied;\n        };\n        input.select();\n        if (navigator.clipboard) {\n            navigator.clipboard.writeText(input.value).then(done, function () {});\n        } else if (document.execCommand('copy')) {\n            done();\n        }\n    });\n})();\n","/* Videos page (custom-videos.hbs + partials/peertube-videos.hbs). Ships\n * inside main.min.js; does nothing on pages without the .gh-videos shell.\n *\n * Lists videos from a self-hosted PeerTube through its public REST API, which\n * answers cross-origin (PeerTube mounts cors() on /api): the instance's own\n * videos, filtered by category when two or more are on offer - the ones the\n * setting lists, or else those of the newest videos. \"todos\" is every one.\n * Order is Random (the default), Trending or Latest. Nearing the end of the\n * grid loads the next 12 on its own, up to AUTO_BATCHES in a view; after\n * that \"Cargar más\" takes over, so the footer stays reachable.\n *\n * Nothing from the instance goes in through innerHTML: every string is set\n * with textContent, URLs are rebuilt on the instance origin, and the player\n * only loads when a visitor presses play.\n */\n(function () {\n    var section = document.querySelector('.gh-videos');\n\n    if (!section || !window.fetch || !window.Promise) {\n        return;\n    }\n\n    var PAGE = 12;\n    // Batches a view loads without a click (the first included): 3 x 12.\n    var AUTO_BATCHES = 3;\n    // Random has no API sort: it shuffles each source's newest RANDOM_POOL\n    // (the API's maximum page) once, then deals PAGE at a time.\n    var RANDOM_POOL = 100;\n    var TIMEOUT = 8000;\n    var UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n    var ALL = '';\n\n    // \"https://host\" or \"https://host | 15, 13 Educación\": the instance, then\n    // optionally the category ids to offer, each with its own name. Any path\n    // on the URL (an old /c/channel setting) is ignored.\n    var parseSource = function (raw) {\n        var parts = String(raw || '').split('|');\n        var url;\n\n        try {\n            url = new URL(parts[0].trim());\n        } catch (e) {\n            return null;\n        }\n\n        if (url.protocol !== 'https:' && url.protocol !== 'http:') {\n            return null;\n        }\n\n        var categories = [];\n        (parts[1] || '').split(',').forEach(function (item) {\n            var match = item.trim().match(/^(\\d{1,9})(?:\\s+(.+))?$/);\n            var known = match && categories.some(function (category) {\n                return category.id === match[1];\n            });\n            if (match && !known) {\n                categories.push({id: match[1], label: match[2] ? match[2].trim() : ''});\n            }\n        });\n\n        return {origin: url.origin, categories: categories};\n    };\n\n    var source = parseSource(section.getAttribute('data-source'));\n\n    if (!source) {\n        return;\n    }\n\n    var grid = section.querySelector('.gh-videos-grid');\n    var message = section.querySelector('.gh-videos-message');\n    var categoryBox = section.querySelector('.gh-videos-category:not(.gh-videos-order)');\n    var picker = categoryBox.querySelector('.gh-videos-select');\n    var pickerValue = categoryBox.querySelector('.gh-videos-category-value');\n    var orderBox = section.querySelector('.gh-videos-order');\n    var order = orderBox.querySelector('.gh-videos-select');\n    var orderValue = orderBox.querySelector('.gh-videos-category-value');\n    var names = section.querySelector('.gh-videos-names');\n    var loading = section.querySelector('.gh-videos-loading');\n    var loadButton = section.querySelector('.gh-videos-load');\n    var labelPlay = section.getAttribute('data-label-play') || 'Play';\n    var labelLive = section.getAttribute('data-label-live') |