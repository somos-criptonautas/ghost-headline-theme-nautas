en and (min-width: 1500px) {\n  .newsletter form {\n    max-width: 70%;\n    margin: auto;\n  }\n}\n\n.newsletter form {\n  border: 0 solid #e5e7eb;\n  box-sizing: border-box;\n}\n\n/* Buttons */\n.it-subscribe-content .subscribe-form-input {\n  outline: 0;\n  box-shadow: 0 0 0 0;\n  border: 3px solid #e1edf4;\n  flex: 1;\n  margin: 0 auto;\n  margin-bottom: 2rem;\n  border-radius: 1rem;\n  width: 350px;\n}\n\n.subscribe-form-input::placeholder {\n  text-align: center;\n}\n\n.it-subscribe-content .subscribe-form-button {\n  margin-left: 0;\n  /*height: 60px;*/\n  cursor: pointer;\n  border-top-left-radius: 0;\n  border-bottom-left-radius: 0;\n  border: 3px solid #e1edf4;\n  margin: 0 auto;\n  width: 350px;\n}\n\n.read-issue {\n  text-align: center;\n  font-weight: 600;\n  background: transparent;\n  outline: 0;\n  border: 0;\n  margin-top: 1em;\n  cursor: pointer;\n}\n\n.read-issue svg {\n  width: 10px;\n  position: relative;\n  top: 3px;\n  left: 3px;\n}\n\n.show {\n  opacity: 1 !important;\n}\n\n.hide {\n  display: none;\n}\n\n.hidden {\n  visibility: hidden;\n}\n\n.related-posts {\n  text-align: center;\n  margin-bottom: 15px;\n}\n\n/* Buttons */\n\n.it-button {\n  display: inline-block;\n  min-width: 75px;\n  height: var(--height);\n  padding: 0 2rem;\n  border: 0;\n  border-radius: var(--radius);\n  cursor: pointer;\n  font-family: var(--font-sans);\n  font-size: 1.4rem;\n  font-weight: var(--font-normal);\n  line-height: var(--height);\n  text-align: center;\n  text-decoration: none;\n  white-space: nowrap;\n  appearance: none;\n}\n\n.it-button.it-button-fit {\n  width: 100%;\n}\n\n.it-button.it-button-small {\n  height: calc(var(--height) * 0.9);\n  line-height: calc(var(--height) * 0.9);\n  padding: 0 1.5rem;\n  font-size: 1.2rem;\n}\n\n.it-button.it-button-large {\n  height: calc(var(--height) * 1.2);\n  line-height: calc(var(--height) * 1.2);\n  padding: 0 2.5rem;\n  font-size: 1.7rem;\n}\n\n.it-button.it-button-disabled,\n.it-button:disabled {\n  pointer-events: none;\n  opacity: 0.33;\n}\n\n.it-button {\n  color: var(--color-primary) !important;\n  background-color: transparent;\n  box-shadow: inset 0 0 0 2px var(--color-primary);\n}\n\n.it-button:hover {\n  text-decoration: none;\n}\n\n.it-button.it-button-primary:hover {\n  background-color: var(--color-primary);\n}\n\n.it-button.it-button-secondary {\n  color: var(--color-base) !important;\n  background-color: none;\n  border: 0.1em solid var(--color-base);\n  box-shadow: none;\n}\n\n.it-button.it-button-secondary:hover {\n  color: var(--color-border) !important;\n  background-color: var(--color-base);\n  box-shadow: none;\n}\n\n.it-button.it-button-danger {\n  color: #fff !important;\n  background-color: var(--color-danger);\n  box-shadow: none;\n}\n\n/* Expired */\n.account-alert-expired {\n  font-size: 1.2rem;\n}\n\n.account-button {\n  margin-right: 12px;\n}\n\n.account-button:hover {\n  text-decoration: underline;\n}\n\n.account-button+.cancel-error {\n  position: absolute;\n  bottom: -6vh;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.account-button.error+.cancel-error {\n  display: inline-table;\n  color: var(--color-font-black);\n  background-color: var(--color-alert-error);\n}\n\n/* RWD — Account page */\n@media screen and (max-width: 767px) {\n  .account-header {\n    padding-bottom: 5vh;\n  }\n}\n\n@media screen and (max-width: 480px) {\n  .account-section+.membership-section {\n    padding-bottom: 3vh;\n  }\n\n  .account-details-title {\n    font-size: 1.6rem;\n  }\n\n  .account-signout {\n    font-size: 1.8rem;\n  }\n}\n\n/* Custom Authors & Tags page */\n.custom-archive {\n  margin-bottom: 9vh;\n}\n\n.custom-archive .item-content {\n  padding-right: 0.2vw;\n}\n\n.custom-archive .item-content small {\n  font-size: 1.4rem;\n  font-weight: 500;\n  margin-top: 0.6vh;\n}\n\n.custom-archive .item-image {\n  margin-bottom: 0.8vh;\n}\n\n.custom-archive .item-title a:hover {\n  text-decoration: none;\n}\n\n.custom-archive .loop-wrap.is-tags .item {\n  margin-bottom: 3vh;\n}\n\n.custom-archive .loop-wrap.is-tags .item-excerpt {\n  -webkit-line-clamp: 3;\n  line-clamp: 3;\n}\n\n/* RWD — Authors & Tags page */\n@media (min-width: 1481px) {\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(3, 1fr);\n  }\n\n  .custom-archive .loop-wrap.is-authors .item-excerpt {\n    -webkit-line-clamp: 6;\n    line-clamp: 6;\n  }\n}\n\n@media screen and (max-width: 1480px) and (min-width: 1281px) {\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media screen and (max-width: 1280px) and (min-width: 1025px) {\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media screen and (max-width: 1024px) and (min-width: 768px) {\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media screen and (max-width: 480px) {\n  .custom-archive {\n    margin-bottom: 6vh;\n  }\n\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(1, 1fr);\n  }\n\n  .custom-archive .item-title {\n    font-size: 2.73rem;\n  }\n}\n\n@media screen and (max-width: 320px) {\n  .custom-archive .loop-wrap {\n    grid-template-columns: repeat(1, 1fr);\n  }\n}\n\n@media (min-width: 1025px) {\n  .custom-archive .item-title {\n    font-size: 2.6rem;\n  }\n\n  .custom-archive .item-excerpt {\n    font-size: 1.6rem;\n  }\n}\n\n.custom-archive .item-title {\n  padding: 0;\n}\n\n/* Youtube without bloatware */\n\n.youtube-player {\n  position: relative;\n  padding-bottom: 56.25%;\n  height: 0;\n  overflow: hidden;\n  max-width: 100%;\n  background: #000;\n  margin: 5px;\n}\n\n.youtube-player iframe {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 100;\n  background: transparent;\n}\n\n.youtube-player img {\n  object-fit: cover;\n  display: block;\n  left: 0;\n  bottom: 0;\n  margin: auto;\n  max-width: 100%;\n  width: 100%;\n  position: absolute;\n  right: 0;\n  top: 0;\n  border: none;\n  height: auto;\n  cursor: pointer;\n  -webkit-transition: 0.23s all;\n  -moz-transition: 0.23s all;\n  transition: 0.23s all;\n}\n\n.youtube-player img:hover {\n  -webkit-filter: brightness(73%);\n  filter: brightness(73%);\n}\n\n.youtube-player .play {\n  height: 3rem;\n  width: 3rem;\n  left: 50%;\n  top: 50%;\n  margin-left: -2rem;\n  margin-top: -2rem;\n  position: absolute;\n  background: url(\"assets/images/play.svg\") no-repeat;\n  cursor: pointer;\n}\n\n/* Loop */\n\n.loop-wrap {\n  margin-bottom: var(--grid-gap);\n  grid-template-columns: repeat(3, 1fr);\n  max-width: 84%;\n  margin: auto;\n}\n\n.loop-wrap,\n.special-wrap {\n  display: grid;\n  width: 100%;\n  gap: 2rem;\n  grid-auto-columns: 1fr;\n  grid-gap: var(--grid-gap);\n}\n\n/* Subtitle */\n.hero-section.no-slider+.loop-section .loop-subtitle {\n  display: none;\n}\n\n.loop-subtitle {\n  display: flex;\n  margin-bottom: 4.5vh;\n  padding-top: 2vh;\n  border-top: var(--border) var(--color-border-one);\n}\n\n.loop-subtitle span {\n  font-weight: var(--font-weight-one-bold);\n}\n\n/* Image */\n.item-image {\n  margin-bottom: 2vh;\n  transition: transform 0.11s ease;\n  min-height: 13vw;\n}\n\n/* RWD — Loop */\n@media screen and (min-width: 992px) {\n  .item.is-loop {\n    opacity: 0.63;\n  }\n\n  /* Dark: at 0.63 the cards sank into the page; a little more present. */\n  html[data-theme=\"dark\"] .item.is-loop {\n    opacity: 0.8;\n  }\n\n  .item.is-loop:hover {\n    opacity: 1 !important;\n  }\n}\n\n@media (max-width: 1600px) {\n  .item-title {\n    font-size: 2.8rem;\n  }\n}\n\n@media (max-width: 1480px) {\n  .special-wrap {\n    margin-bottom: 7vh;\n    grid-template-columns: repeat(5, 1fr);\n  }\n\n  .item-title {\n    font-size: 2.6rem;\n    margin-top: 0.5vh;\n  }\n\n  .item.is-featured .item-title {\n    font-size: 2.4rem;\n  }\n\n  .item-excerpt {\n    font-size: 1.6rem;\n    margin-top: 1.5vh;\n  }\n\n  .item.is-special .item-title {\n    font-size: 1.8rem;\n  }\n}\n\n@media (max-width: 1480px) and (min-width: 768px) {\n  .item.is-special:nth-child(6) {\n    display: none;\n  }\n}\n\n@media (max-width: 1280px) {\n  .loop-subtitle {\n    margin-bottom: 4vh;\n  }\n\n  .item.is-loop {\n    margin-bottom: 3vh;\n  }\n\n  .item-title {\n    font-size: 2.4rem;\n  }\n\n  .item.is-featured,\n  .item.is-featured.is-small {\n    width: 30%;\n  }\n\n  .item.is-featured .item-title {\n    font-size: 2.2rem;\n  }\n\n  .item.is-featured .item-excerpt {\n    -webkit-line-clamp: 3;\n    line-clamp: 3;\n  }\n}\n\n.gh-article-sidebar .gh-button-share {\n  margin-top: 16px;\n}\n\n@media (max-width: 1199px) {\n  .loop-wrap {\n    grid-template-columns: repeat(2, 1fr);\n    max-width: 100% !important;\n  }\n\n  .special-wrap {\n    grid-template-columns: repeat(4, 1fr);\n  }\n\n  .item-excerpt {\n    font-size: 1.4rem;\n    -webkit-line-clamp: 3;\n    line-clamp: 3;\n  }\n}\n\n@media (max-width: 1024px) and (min-width: 768px) {\n  .item.is-special:nth-child(5) {\n    display: none;\n  }\n}\n\n@media (max-width: 767px) {\n\n  .loop-wrap,\n  .special-wrap {\n    gap: calc(var(--grid-gap) / 1.5);\n    grid-gap: calc(var(--grid-gap) / 1.5);\n  }\n\n  .loop-subtitle {\n    margin-bottom: 2.5vh;\n  }\n\n  .special-wrap {\n    grid-template-columns: repeat(3, 1fr);\n  }\n\n  .item.is-featured {\n    margin-right: calc(var(--grid-gap) / 1.5);\n  }\n\n  .item.is-featured .item-tags span {\n    display: none;\n  }\n\n  .item.is-featured,\n  .item.is-featured.is-small {\n    width: 40%;\n  }\n\n  .item-title {\n    font-size: 2.2rem;\n    line-height: 1.11;\n  }\n\n  .item-author {\n    width: 27px;\n    height: 27px;\n  }\n}\n\n@media (max-width: 767px) and (min-width: 481px) {\n  .item.is-loop .item-tags span {\n    display: none;\n  }\n}\n\n@media (max-width: 480px) {\n  .loop-wrap {\n    grid-template-columns: repeat(1, 1fr);\n  }\n\n  .special-wrap {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .item.is-featured,\n  .item.is-featured.is-small {\n    width: 80%;\n  }\n\n  .item.is-special:nth-child(5),\n  .item.is-special:nth-child(6) {\n    display: none;\n  }\n\n  .item-title {\n    font-size: 2.4rem;\n  }\n}\n\n@media (max-width: 320px) {\n  .item.is-special .item-authors {\n    display: none;\n  }\n}\n\n/* Authors */\n.global-item-author {\n  position: relative;\n  display: inline-block;\n  overflow: hidden;\n  width: 2rem;\n  height: 2rem;\n  margin-right: -25px;\n  transition-timing-function: ease;\n  transition-duration: 0.2s;\n  transition-property: transform, background-color;\n  pointer-events: none;\n  border: 6px solid transparent;\n  background-color: var(--color-bg);\n  will-change: transform;\n}\n\n.global-item-author:last-of-type {\n  margin-right: -10px;\n}\n\n.global-item-author:hover {\n  transform: translateY(-2px);\n}\n\n.global-item-author:not(.is-image) a {\n  z-index: -1;\n  background-color: var(--color-one);\n}\n\n.global-item-author:nth-child(1) {\n  z-index: 5;\n}\n\n.global-item-author:nth-child(2) {\n  z-index: 4;\n}\n\n.global-item-author:nth-child(3) {\n  z-index: 3;\n}\n\n.global-item-author:nth-child(4) {\n  z-index: 2;\n}\n\n.global-item-author:nth-child(5) {\n  z-index: 1;\n}\n\n.global-item-author,\n.global-item-author.is-image a {\n  border-radius: 100px;\n}\n\n.global-item-author a {\n  pointer-events: auto;\n}\n\n.global-item-author img {\n  width: 101%;\n  height: 101%;\n}\n\n.global-item-author span {\n  font-family: Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\",\n    monospace;\n  font-size: 1.8rem;\n  font-weight: normal;\n  line-height: 18px;\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: block;\n  overflow: hidden;\n  width: calc(1ch + 4px);\n  transform: translate(-50%, -50%);\n  text-align: center;\n  white-space: nowrap;\n  text-indent: 2px;\n  letter-spacing: 4px;\n  text-transform: uppercase;\n  color: var(--color-font-three);\n}\n\n/* Content */\n.item-content {\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n  padding-right: 2.5vw;\n}\n\nhtml.no-infinite-scroll .pagination {\n  display: grid;\n}\n\n/* Title */\n.item-title {\n  font-family: var(--gh-font-heading);\n  font-size: 3rem;\n  line-height: 1.13s;\n  max-width: 490px;\n  margin: 1vh 0 0;\n}\n\n.item-title a:hover {\n  text-decoration-thickness: 2px;\n  text-underline-offset: 3px;\n}\n\n/* Excerpt */\n.item-excerpt {\n  font-size: 1.8rem;\n  line-height: 1.5;\n  display: -webkit-box;\n  overflow: hidden;\n  max-width: 540px;\n  margin: 0;\n  margin-top: 1.5vh;\n  padding-right: 0.4vw;\n  opacity: var(--opacity-two);\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 4;\n  line-clamp: 4;\n}\n\n.item-excerpt.no-image {\n  -webkit-line-clamp: 10;\n  line-clamp: 10;\n}\n\n/* Item */\n.item {\n  will-change: transform;\n}\n\n/* If 'loop' */\n.item.is-loop {\n  margin-bottom: 5.2vh;\n}\n\n/* If 'featured' */\n.item.is-featured {\n  width: 41%;\n  margin-right: var(--grid-gap);\n}\n\n.item.is-featured:last-child {\n  margin-right: 0;\n}\n\n.item.is-featured.is-small {\n  width: 29%;\n}\n\n.item.is-featured .item-title,\n.item.is-featured .item-excerpt {\n  max-width: 550px;\n}\n\n.item.is-featured.is-small .item-excerpt {\n  -webkit-line-clamp: 3;\n  line-clamp: 3;\n}\n\n/* If 'special' */\n.comments-section+.special-section {\n  margin-top: 0;\n}\n\n.special-wrap {\n  margin-bottom: 8vh;\n  grid-template-columns: repeat(6, 1fr);\n}\n\n.item.is-special {\n  margin-bottom: 1vh;\n}\n\n.item.is-special .item-image {\n  margin-bottom: 1vh;\n}\n\n.item.is-special .item-content {\n  padding-right: 10px;\n}\n\n.item.is-special .item-title {\n  font-size: 2rem;\n  line-height: 1.3;\n}\n\n/* Animation */\n@-webkit-keyframes slideTop {\n  0% {\n    transform: translateY(40px);\n  }\n\n  100% {\n    transform: translateY(0);\n  }\n}\n\n@keyframes slideTop {\n  0% {\n    transform: translateY(40px);\n  }\n\n  100% {\n    transform: translateY(0);\n  }\n}\n\n/* Weird update */\n\n.gh-canvas,\n.kg-width-full.kg-content-wide {\n  --main: min(var(--content-width, 720px), 100% - var(--gap) * 2);\n  --wide: minmax(0,\n      calc((var(--container-width, 1100px) - var(--content-width, 720px)) / 2));\n  --full: minmax(var(--gap), 1fr);\n  display: grid;\n  grid-template-columns:\n    [full-start] var(--full) [wide-start] var(--wide) [main-start] var(--main) [main-end] var(--wide) [wide-end] var(--full) [full-end];\n}\n\n.gh-canvas>* {\n  grid-column: main;\n}\n\n.kg-content-wide>div,\n.kg-width-wide {\n  grid-column: wide;\n}\n\n.kg-width-full {\n  grid-column: full;\n}\n\n.gh-content table:not(.gist table) {\n  -webkit-overflow-scrolling: touch;\n  background: radial-gradient(ellipse at left,\n      rgba(0, 0, 0, 0.2) 0,\n      transparent 75%) 0,\n    radial-gradient(ellipse at right, rgba(0, 0, 0, 0.2) 0, transparent 75%) 100%;\n  background-attachment: scroll, scroll;\n  background-repeat: no-repeat;\n  background-size: 10px 100%, 10px 100%;\n  border-collapse: collapse;\n  border-spacing: 0;\n  display: inline-block;\n  font-family: var(--font-sans);\n  font-size: 1.6rem;\n  max-width: 100%;\n  overflow-x: auto;\n  vertical-align: top;\n  white-space: nowrap;\n  width: auto;\n}\n\n.gh-content table:not(.gist table) td:first-child {\n  background-image: linear-gradient(90deg, #fff 50%, hsla(0, 0%, 100%, 0));\n  background-repeat: no-repeat;\n  background-size: 20px 100%;\n}\n\n.gh-content table:not(.gist table) td:last-child {\n  background-image: linear-gradient(270deg, #fff 50%, hsla(0, 0%, 100%, 0));\n  background-position: 100% 0;\n  background-repeat: no-repeat;\n  background-size: 20px 100%;\n}\n\n.gh-content table:not(.gist table) th {\n  background-color: var(--color-white);\n  color: var(--color-darkgrey);\n  font-size: 1.2rem;\n  font-weight: 700;\n  letter-spacing: 0.2px;\n  text-align: left;\n  text-transform: uppercase;\n}\n\n.gh-content table:not(.gist table) td,\n.gh-content table:not(.gist table) th {\n  border: 1px solid var(--color-light-gray);\n  padding: 6px 12px;\n}\n\n.gh-content .kg-nested-list-item {\n  list-style-type: none;\n}\n\n.gh-content ol ol li {\n  list-style-type: lower-alpha;\n}\n\n.gh-content ol ol ol li {\n  list-style-type: lower-roman;\n}\n\n.no-menu .gh-foot-inner {\n  align-items: center;\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.gh-content :not(.kg-card):not(table):not([id])+ :is(.kg-card, table) {\n  margin-top: calc(2em * var(--content-spacing-multiplier, 1));\n}\n\n.gh-content :not(.kg-card):not(table):not([id])+ :is(.kg-card, table):last-child {\n  margin: calc(2em * var(--content-spacing-multiplier, 1)) 0;\n}\n\n.gh-content :is(.kg-card, table)+ :not(.kg-card):not(table):not([id]) {\n  margin-top: calc(3em * var(--content-spacing-multiplier, 1));\n}\n\n.gh-canvas>* {\n  grid-column: main;\n}\n\n.kg-content-wide>div,\n.kg-width-wide {\n  grid-column: wide;\n}\n\n.kg-width-full {\n  grid-column: full;\n}\n\nli.nav-coaching a {\n  font-weight: 600 !important;\n}\n\n.gh-content video {\n  width: 100%;\n  max-width: none;\n  margin: 2rem 0;\n}\n\n.responsive-iframe-container {\n  position: relative;\n  width: 100%;\n  height: 0;\n  padding-bottom: 56.25%;\n  /* 16:9 aspect ratio */\n  overflow: hidden;\n}\n\n.responsive-iframe {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  border: none;\n}\n\n/* Full-width on larger screens */\n@media (min-width: 768px) {\n  .bunny-video-wrapper {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n  }\n}\n\n/* Wide content support for modern Ghost themes */\n@media (min-width: 1024px) {\n  .bunny-video-wrapper {\n    width: calc(100vw - 4rem);\n    margin-left: calc(50% - 50vw + 2rem);\n  }\n}\n\n/* Disable footer on coaching-page */\n.page-coaching .gh-foot-menu {\n  display: none !important;\n}\n\n/* Better announcement on mobile */\n@media (max-width: 1024px) {\n  .gh-announcement-bar {\n    padding: 1.5rem !important;\n  }\n}\n\n.gh-announcement-bar svg {\n  width: 1.3rem !important;\n  height: 1.3rem !important;\n}\n\n/* Hamburger */\n\n.gh-burger {\n  display: none;\n  position: fixed;\n  top: 1.5rem;\n  right: 2rem;\n  width: 5.66rem;\n  height: 5.66rem;\n  background-color: var(--color-light-gray);\n  border-radius: var(--border-radius);\n  opacity: 0.77;\n  z-index: 11;\n}\n\n@media screen and (max-width: 991px) {\n  .gh-burger {\n    display: block;\n  }\n}\n\n.gh-burger::before,\n.gh-burger::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  bottom: auto;\n  width: 3.4rem;\n  height: 3px;\n  border-radius: 3px;\n  background-color: var(--color-base);\n}\n\n\n.gh-burger::before {\n  transform: translate(-50%, calc(-50% - 0.55rem));\n}\n\n.gh-burger::after {\n  transform: translate(-50%, calc(-50% + 0.55rem));\n}\n\n.is-head-open .gh-burger {\n  opacity: 1;\n  background-color: transparent;\n}\n\n.is-head-open .gh-burger::before {\n  top: 50%;\n  bottom: auto;\n  left: 50%;\n  transform: translate(-50%, -50%) rotate(45deg);\n}\n\n.is-head-open .gh-burger::after {\n  top: 50%;\n  bottom: auto;\n  left: 50%;\n  transform: translate(-50%, -50%) rotate(-45deg);\n}\n\nhtml[data-theme=\"dark\"] .gh-burger::before,\nhtml[data-theme=\"dark\"] .gh-burger::after {\n  background-color: var(--color-bg);\n}\n\nhtml[data-theme=\"dark\"] .is-head-open .gh-burger::before,\nhtml[data-theme=\"dark\"] .is-head-open .gh-burger::after {\n  background-color: var(--color-base);\n}\n\n/* Author labels */\n/* Show first author label only */\n.global-authors small {\n  display: none;\n  width: 100%;\n  margin-top: 1.5vh;\n  font-size: 1.4rem;\n  line-height: 1;\n}\n\n.global-authors.option-1 small:nth-of-type(1),\n.global-authors.option-1-2 small:nth-of-type(2),\n.global-authors.option-1-2-3 small:nth-of-type(3) {\n  display: block;\n}\n\n/* Comments heading */\n/* \"Comentarios\": a subheading over the forum thread - the size of an h2\n   inside an article (.gh-content h2), centered,\n   with room above it and little between it and the thread. */\n.comunidad-comments .gh-pagehead-title,\n.gh-content .comunidad-comments .gh-pagehead-title {\n  margin: 0;\n  font-size: 2.66rem;\n  text-align: center;\n}\n\n.comunidad-comments .gh-pagehead {\n  margin: 5rem auto 1.2rem;\n}\n\n.account-signout-wrap {\n  width: 100%;\n  margin-top: 2vh;\n  padding-top: 18px;\n  text-align: right;\n  border-top: 1px solid var(--color-border);\n}\n\n/* Invisible last-featured-item marker (item.hbs). */\n.featured-wrap .item-image .is-last {\n  position: absolute;\n  z-index: 1;\n  top: 10px;\n  right: 10px;\n  width: 1px;\n  height: 1px;\n  background-color: transparent;\n}\n\n/* Webmentions */\n.wm-container {\n  padding: 2.5rem;\n  margin: 4rem 0 6rem;\n  background: var(--color-bg-alt);\n  border-radius: var(--border-radius);\n}\n\n.wm-header {\n  margin-bottom: 2rem;\n  font-family: var(--gh-font-heading);\n  font-size: 2.4rem;\n  font-weight: var(--font-bold);\n  color: var(--color-base);\n}\n\n/* Likes and reposts */\n.wm-avatar-grid {\n  display: flex;\n  align-items: center;\n  padding-bottom: 2rem;\n  margin-bottom: 2rem;\n  border-bottom: 1px solid var(--color-border);\n}\n\n.wm-avatar-grid .wm-avatar-link {\n  position: relative;\n  z-index: 1;\n  width: 40px;\n  height: 40px;\n  margin-right: -10px;\n  opacity: 0.78;\n  transition: opacity 0.2s var(--animation-base);\n}\n\n.wm-avatar-grid .wm-avatar-link:hover {\n  opacity: 1;\n}\n\n.wm-avatar-grid .wm-avatar-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border: 2px solid var(--color-bg-alt);\n  border-radius: 50%;\n}\n\n.wm-reactions-count {\n  margin-left: 1.5rem;\n  font-size: 1.5rem;\n  color: var(--color-base);\n  opacity: 0.63;\n}\n\n/* Replies and mentions */\n.wm-mention-item {\n  display: grid;\n  grid-template-columns: 40px 1fr;\n  gap: 15px;\n  padding: 20px 0;\n  border-bottom: 1px solid var(--color-border);\n}\n\n.wm-mention-item:last-child {\n  border-bottom: none;\n}\n\n.wm-author-img {\n  width: 40px;\n  height: 40px;\n  object-fit: cover;\n  border-radius: 50%;\n}\n\n.wm-mention-content-wrapper {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.wm-author-name {\n  font-size: 1.5rem;\n  font-weight: var(--font-bold);\n  color: var(--color-base);\n}\n\n.wm-mention-content {\n  font-size: 1.5rem;\n  line-height: 1.5;\n  color: var(--color-base);\n}\n\n.wm-mention-source-line,\n.wm-mention-metadata {\n  font-size: 1.4rem;\n  color: var(--color-base);\n  opacity: 0.63;\n}\n\n.wm-mention-source {\n  color: var(--ghost-accent-color);\n}\n\n.wm-loading {\n  font-size: 1.5rem;\n  opacity: 0.63;\n}\n/* Infinite scroll */\nhtml.js .gh-loadmore {\n  display: none;\n}\n\n/* Tablet/mobile header bar */\n.gh-head-search-field,\n.gh-head-bar-toggle {\n  display: none;\n}\n\n@media screen and (max-width: 991px) {\n  :root {\n    --head-bar-height: 6.4rem;\n  }\n\n  /* Fixed, not sticky */\n  body:not(.is-head-open) #gh-head {\n    position: fixed;\n    top: var(--head-top, 0px);\n    right: 0;\n    left: 0;\n    z-index: 90;\n    height: auto;\n    background-color: var(--color-bg);\n  }\n\n  /* A fixed bar takes no layout space: push the page down by its height. */\n  .gh-site {\n    padding-top: var(--head-bar-height);\n  }\n\n  #gh-head .gh-head-brand {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    column-gap: 1.2rem;\n    align-items: center;\n    width: 100%;\n    height: var(--head-bar-height);\n    margin-bottom: 0;\n    padding-block: 0;\n  }\n\n  #gh-head .gh-head-search-field {\n    grid-row: 1;\n    grid-column: 1;\n  }\n\n  #gh-head .gh-burger {\n    position: relative;\n    top: auto;\n    right: auto;\n    grid-row: 1;\n    grid-column: 2;\n    width: 4rem;\n    height: 4rem;\n    opacity: 1;\n    background-color: transparent;\n  }\n\n  /* Hide-on-scroll, driven by assets/js/head.js. The open menu\n     is the full-screen sheet, which must never slide away. */\n  body:not(.is-head-open) #gh-head {\n    transition: transform 0.33s var(--animation-base, ease);\n  }\n\n  body:not(.is-head-open) #gh-head.is-unpinned {\n    transform: translateY(-100%);\n  }\n\n  /* Burger bar color */\n  #gh-head .gh-burger::before,\n  #gh-head .gh-burger::after {\n    width: 2.4rem;\n    background-color: var(--color-base);\n  }\n\n  /* Hidden logo wrapper */\n  body:not(.is-head-open) #gh-head .gh-head-brand-wrapper {\n    display: none;\n  }\n\n  /* Open state layout */\n  .is-head-open #gh-head .gh-head-brand {\n    grid-template-columns: minmax(0, 1fr) auto auto;\n    grid-template-rows: var(--head-bar-height) auto;\n    height: auto;\n  }\n\n  /* Toggle size */\n  .is-head-open #gh-head .gh-head-bar-toggle {\n    display: inline-flex;\n    grid-row: 1;\n    grid-column: 2;\n    width: 2.2rem;\n    height: 2.2rem;\n    margin: 0;\n  }\n\n  .is-head-open #gh-head .gh-burger {\n    grid-column: 3;\n  }\n\n  /* Brand margin. No flex growth and no auto margins below: the whole stack\n     sits right under the bar and keeps its own spacing. */\n  .is-head-open #gh-head .gh-head-brand {\n    flex: 0 0 auto;\n  }\n\n  .is-head-open #gh-head .gh-head-brand-wrapper {\n    grid-row: 2;\n    grid-column: 1 / -1;\n    justify-content: center;\n    margin-block: 5vh;\n  }\n\n  .gh-head-search-field {\n    display: flex;\n    align-items: center;\n    gap: 0.8rem;\n    width: 100%;\n    min-width: 0;\n    height: 4rem;\n    padding: 0 1.4rem;\n    color: var(--color-base);\n    background: var(--color-bg-alt);\n    border: 1px solid var(--color-border);\n    border-radius: 999px;\n  }\n\n  .gh-head-search-field:focus-within {\n    outline: 2px solid var(--ghost-accent-color);\n    outline-offset: 2px;\n  }\n\n  .gh-head-search-field svg {\n    flex: none;\n    width: 1.8rem;\n    height: 1.8rem;\n    opacity: 0.63;\n  }\n\n  /* Never below 16px: iOS zooms the page when focusing a smaller input. */\n  .gh-head-search-field input {\n    flex: 1;\n    min-width: 0;\n    height: 100%;\n    padding: 0;\n    font: inherit;\n    font-size: max(16px, 1.5rem);\n    color: inherit;\n    background