oll;\n    position: fixed;\n    z-index: 999999;\n  }\n\n  #gh-head .nav {\n    align-items: center;\n    gap: 20px;\n    line-height: 1.4;\n  }\n\n  .is-head-open #gh-head :is(.gh-head-btn, .gh-head-link) {\n    opacity: 1;\n    transform: translateY(0);\n    transition: transform 0.4s, opacity 0.4s;\n    transition-delay: 0s, 0s;\n    transition-delay: 0.2s;\n  }\n\n  #gh-head .nav a {\n    font-size: 2.4rem;\n    font-weight: 600;\n    text-transform: none;\n  }\n}\n\n@media screen and (min-width: 992px) and (max-width: 1349px) {\n  .is-head-b--a_n .gh-head-inner {\n    row-gap: 0;\n    grid-template-columns: 5fr 1fr;\n  }\n}\n\n@media (width >=1350px) {\n  .is-head-b--a_n .gh-head-inner {\n    grid-template-columns: 4fr 10fr 3fr;\n    align-content: center;\n  }\n}\n\n@media screen and (min-width: 992px) {\n  .gh-head-inner {\n    padding: 1.63rem;\n  }\n}\n\n.gh-head-inner {\n  font-weight: 500;\n}\n\n.actions-container,\n.gh-head-brand {\n  display: flex;\n  align-items: center;\n}\n\n@media screen and (max-width: 991px) {\n  .actions-container {\n    flex-direction: column;\n  }\n}\n\n@media screen and (max-width: 1350px) {\n  .gh-head-brand {\n    display: none;\n  }\n}\n\n.gh-head-btn.gh-btn {\n  font-size: 2.11rem;\n  padding: 1rem 2rem;\n  z-index: 0;\n  margin-right: 2rem;\n  border-radius: 999px;\n  box-shadow: var(--cn-shadow-sm);\n}\n\n.gh-head-menu {\n  height: 2rem;\n  flex-wrap: wrap;\n  flex-direction: column;\n}\n\n.gh-head-menu::after {\n  top: 136px;\n}\n\nbody:not(.is-head-b--a_n) .gh-head-menu::after {\n  display: none;\n}\n\n@media screen and (max-width: 991px) {\n  .gh-article-sidebar {\n    margin-top: 5rem;\n    flex-direction: row-reverse;\n    align-items: center;\n  }\n\n  .gh-article-sidebar a {\n    padding-top: 0.33rem;\n  }\n}\n\n.gh-article-sidebar {\n  display: flex;\n  grid-template-columns: auto 1fr;\n  grid-column: main-start / main-end;\n  column-gap: 0.5rem;\n  align-content: center;\n  align-items: center;\n}\n\n.gh-article-sidebar .gh-author-image {\n  grid-row: 1 / 3;\n  width: 11rem;\n  height: 11rem;\n  margin-bottom: 0;\n  border-radius: 50%;\n}\n\n.it-social-share {\n  display: flex;\n  margin-top: 2rem;\n}\n\n.it-social-share>a {\n  margin-left: 1.5rem;\n}\n\n.it-social-share>a>svg {\n  width: 5rem;\n  margin-top: 0.3rem;\n  fill: var(--color-base);\n  padding: 0.76rem 1.23rem;\n  opacity: 0.77;\n}\n\n.it-social-share>a>svg:hover {\n  outline: solid var(--color-base) 0.1em;\n  border-radius: 0.1em;\n  opacity: 1;\n}\n\n/* margin in articles */\n\n.gh-full-content {\n  display: flex;\n}\n\n@media screen and (max-width: 991px) {\n\n  .gh-full-content,\n  .gh-topic .gh-topic-grid {\n    display: inherit !important;\n    margin: 0 3vh;\n  }\n}\n\n@media screen and (max-width: 991px) {\n\n  .gh-full-content,\n  .gh-topic .gh-topic-grid {\n    margin-top: 0;\n  }\n}\n\n\n/* Pages open with their first block under the header; 80px from the shared\n   assets read as cramped against this theme's cover. */\n.page-template .gh-content:only-child > :first-child:not(.kg-width-full) {\n  margin-top: clamp(9rem, 12vh, 15rem);\n}\n\n/* TOC (Table of Contents) */\n\n.toc {\n  display: flex;\n  flex-direction: column;\n  /* the sticky lives on .gh-sidebar; nesting a second one here did nothing */\n  font-size: 1.8rem;\n  line-height: 1.35;\n  /* overflow-y alone makes overflow-x compute to auto, so marking a heading\n     active let the browser scroll this box sideways to reveal it. */\n  overflow-x: clip;\n  overflow-y: auto;\n}\n\n/* assets/js/toc.js hides the list on posts with fewer than 3 headings;\n   the display: flex above would otherwise override `hidden`. */\n.toc[hidden] {\n  display: none;\n}\n\n.toc-list-item {\n  padding: 0.6rem 0;\n  opacity: 0.63;\n  list-style: none;\n}\n\n/* tocbot nests an h2 list inside its h1 item - indent it so the hierarchy reads */\n.toc-list .toc-list {\n  padding-left: 1.6rem;\n}\n\na.toc-link {\n  display: block;\n  color: inherit;\n  text-decoration: none;\n  overflow-wrap: anywhere;\n}\n\n@media screen and (min-width: 992px) {\n  .toc-list-item.is-active-li {\n    opacity: 1;\n  }\n\n  .toc-list-item:hover {\n    opacity: 1;\n  }\n}\n\n/* TOC sidebar */\n.gh-sidebar h3 {\n  margin: 0 0 1.2rem;\n  padding: 0;\n  font-size: 2.6rem;\n}\n\n@media screen and (max-width: 991px) {\n  .gh-sidebar {\n    background-color: var(--color-border);\n    color: var(--color-bg);\n    padding: 3rem 3.33rem;\n    width: 100%;\n    max-width: 100%;\n    margin: 4rem 0 !important;\n  }\n\n  a.toc-link {\n    color: var(--color-base);\n  }\n}\n\n/* toc */\n\n@media screen and (max-width: 991px) {\n  .welcome-figures {\n    margin: 50px auto 0px;\n  }\n}\n\n\n.gh-icon-btn,\n.feather {\n  width: 3rem;\n  height: 3rem;\n  margin-left: 0.5rem;\n  margin-right: 0.5rem;\n  align-items: initial;\n}\n\n.feather {\n  margin-bottom: 0.25rem;\n}\n\n/* Dark/light */\n\n.icon-light {\n  display: none;\n}\n\n.icon-dark {\n  display: block;\n}\n\n@media screen and (max-width: 991px) {\n  .it-dark-light:hover .icon-light svg {\n    fill: var(--color-base);\n  }\n\n  /* The open phone menu: the logo across the top. */\n  .is-head-open img.logo-nav {\n    max-width: min(100%, 28rem);\n    max-height: 4.4rem;\n    margin: auto;\n  }\n}\n\n/* The shared header.css stacks a second logo image invisibly over the first\n   (absolute, opacity 0); here the second is the dark logo, shown on its own. */\n.gh-head-logo img:nth-child(2) {\n  position: static;\n  opacity: 1;\n}\n\n/* One logo at a time: the dark one in dark mode (default.hbs). */\nhtml[data-theme=\"dark\"] .logo-nav.logo-light,\nhtml:not([data-theme=\"dark\"]) .logo-nav.logo-dark {\n  display: none;\n}\n\n.it-dark-light:hover .icon-dark svg {\n  fill: #111;\n}\n\nhtml[data-theme=\"dark\"] .icon-light {\n  display: block !important;\n}\n\nhtml[data-theme=\"dark\"] .icon-dark {\n  display: none;\n}\n\nhtml[data-theme=\"dark\"] .it-social-share>a>svg {\n  fill: var(--color-bg);\n}\n\nhtml[data-theme=\"dark\"] .it-social-share>a>svg:hover {\n  outline: solid var(--color-bg) 0.1em;\n}\n\nhtml[data-theme=\"dark\"] .it-button.it-button-primary {\n  background: var(--color-base) !important;\n  color: var(--color-bg) !important;\n}\n\nhtml[data-theme=\"dark\"] .it-button.it-button-primary:hover {\n  color: var(--cn-on-violeta) !important;\n  background: var(--color-primary-hover) !important;\n}\n\nhtml[data-intro=\"hide\"] {\n  --transform: translate(-120vw);\n  --overflow-y: scroll;\n  overflow: auto;\n}\n\n.is-head-open html {\n  overflow: hidden !important;\n}\n\nhtml,\nbody,\n.gh-head {\n  background: var(--color-bg);\n}\n\n/* The header a shade off the page, as on the forum. */\n.gh-head {\n  background: var(--cn-ui-header);\n}\n\nhtml,\nbody,\n.gh-head {\n  color: var(--color-base) !important;\n}\n\n.global-question {\n  display: block;\n  margin-top: 6.23vh;\n}\n\n/* Account page */\n.account-section {\n  padding-bottom: 6.23vh;\n}\n\n/* Question */\n.membership-wrap+small {\n  margin-top: 2vh;\n  text-align: center;\n}\n\n/* FAQs */\n.faq-section {\n  margin-top: -3vh;\n  margin-bottom: 20vh;\n}\n\n.faq-title {\n  font-size: 6.6rem;\n  margin: 0 0 4vh;\n  text-align: center;\n}\n\n.faq-content {\n  max-width: 820px;\n  margin: 0 auto;\n}\n\n.faq-content .kg-toggle-card {\n  padding: 0;\n  border-top: 0;\n  border-bottom: var(--border) var(--color-border-one);\n  border-radius: 0;\n  box-shadow: none;\n}\n\n.faq-content .kg-toggle-card:first-of-type {\n  border-top: var(--border) var(--color-border-one);\n}\n\n.faq-content .kg-toggle-card,\n.faq-content .kg-toggle-card+.kg-toggle-card {\n  margin-top: 0;\n}\n\n.faq-content .kg-toggle-card .kg-toggle-heading {\n  position: relative;\n  padding: 3.2vh 12vw 3.2vh 0;\n}\n\n.faq-content .kg-toggle-card .kg-toggle-heading-text {\n  font-family: var(--gh-font-heading);\n  font-size: 2.6rem;\n  font-weight: 500;\n  line-height: 1.3;\n}\n\n.faq-content .kg-toggle-card .kg-toggle-card-icon {\n  position: absolute;\n  top: calc(50% - 10px);\n  right: 10px;\n  margin: 0;\n  padding: 0;\n  cursor: pointer;\n}\n\n.faq-content .kg-toggle-card .kg-toggle-card-icon,\n.faq-content .kg-toggle-card .kg-toggle-card-icon svg {\n  width: 20px;\n  height: 20px;\n  color: var(--color-three);\n}\n\n.faq-content [data-kg-toggle-state=\"open\"] .kg-toggle-card-icon {\n  transform: rotate(0);\n}\n\n.faq-content .kg-toggle-card .kg-toggle-content p {\n  font-size: 2rem;\n  box-sizing: initial;\n  max-width: 700px;\n  margin-bottom: 5vh;\n  padding: 0 4vw 0 0;\n}\n\n/* RWD — Membership page */\n@media screen and (max-width: 1480px) {\n  .membership-section {\n    padding-bottom: 12vh;\n  }\n\n  .membership-wrap {\n    padding: 3vh;\n  }\n\n  .membership-switch {\n    margin-top: 4vh;\n  }\n\n  .membership-card {\n    margin: calc(var(--grid-gap) / 2);\n    border-radius: calc(var(--border-radius) / 2);\n  }\n\n  .membership-card-label {\n    font-size: 1.6rem;\n    margin-bottom: 20px;\n    padding-right: 12px;\n    padding-left: 12px;\n  }\n\n  .membership-card-price {\n    font-size: 7.2rem;\n  }\n\n  .membership-card-content p,\n  .membership-card-list ul {\n    margin-top: 20px;\n  }\n\n  .membership-card-list ul {\n    padding-top: 20px;\n  }\n\n  .membership-card-list li,\n  .membership-card-price span {\n    font-size: 1.8rem;\n  }\n\n  .membership-card-list li {\n    margin-bottom: 10px;\n  }\n\n  .membership-card-list li::before {\n    font-size: 1.6rem;\n    margin-right: 6px;\n    transform: translateY(-2px);\n  }\n}\n\n@media screen and (max-width: 1280px) {\n  .membership-card-price {\n    font-size: 6.6rem;\n  }\n}\n\n@media screen and (max-width: 1024px) {\n  .membership-section {\n    padding-bottom: 5vh;\n  }\n\n  .membership-card {\n    max-width: calc(100% - var(--grid-gap));\n  }\n\n  .faq-section {\n    margin-bottom: 18vh;\n  }\n}\n\n@media screen and (max-width: 767px) {\n  .membership-switch {\n    max-width: 300px;\n    min-height: 50px;\n  }\n\n  .membership-switch button {\