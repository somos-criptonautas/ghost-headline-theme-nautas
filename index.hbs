{{!< default}}
{{!-- /blog/ (and /page/2/ on): every post, newest first, loading on as the
    reader scrolls. The community: the aside column from 768px, on phones
    the strip after the third post, as the reader scrolls into the list.
    Page 1 opens with the feature image of the Ghost page "blog", when there
    is one (its own URL is taken by this route, so it shows only here), then
    the forum and the level pills over every post, newest first. Featured
    posts are the landing's (home.hbs), not repeated here. --}}
<main class="gh-main gh-outer">
    <div class="gh-inner">
    <div class="gh-with-sidebar">
        <div class="gh-with-sidebar-main">
        {{^if pagination.prev}}
        {{#get "pages" filter="slug:blog" limit="1"}}{{#foreach pages}}{{#if feature_image}}
        <figure class="gh-blog-image">
            <img srcset="{{img_url feature_image size="m" format="webp"}} 720w, {{img_url feature_image size="l" format="webp"}} 960w,
                {{img_url feature_image size="xl" format="webp"}} 1200w, {{img_url feature_image size="xxl" format="webp"}} 2000w"
                sizes="(max-width: 1200px) 100vw, 1200px" src="{{img_url feature_image size="xl" format="webp"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </figure>
        {{/if}}{{/foreach}}{{/get}}
        {{!-- Every post by level (the internal tags #nivel-1..3): one switch per
            level with posts, all on; turning one off takes its posts out of the
            list (assets/js/levels.js, which keeps the choice in this browser). --}}
        <div class="gh-levels" role="group" aria-label="{{t "Level"}}">
            {{#get "posts" filter="tag:hash-nivel-1" limit="1"}}{{#if posts}}<button class="gh-level-switch" type="button" role="switch" aria-checked="true" data-level="hash-nivel-1">{{t "level"}} 1</button>{{/if}}{{/get}}
            {{#get "posts" filter="tag:hash-nivel-2" limit="1"}}{{#if posts}}<button class="gh-level-switch" type="button" role="switch" aria-checked="true" data-level="hash-nivel-2">{{t "level"}} 2</button>{{/if}}{{/get}}
            {{#get "posts" filter="tag:hash-nivel-3" limit="1"}}{{#if posts}}<button class="gh-level-switch" type="button" role="switch" aria-checked="true" data-level="hash-nivel-3">{{t "level"}} 3</button>{{/if}}{{/get}}
        </div>
        {{/if}}

        <div class="gh-topic gh-topic-grid gh-topic-grid-item gh-listing">
            <div class="gh-topic-content gh-feed">
                {{#foreach posts}}
                    {{> "loop-grid" has_large_post=false}}
                    {{#has number="3"}}{{^is "paged"}}{{> "community-related" strip=true}}{{/is}}{{/has}}
                {{/foreach}}
            </div>

            {{!-- Without this, a reader with no JS reaches /page/2 and has no
                way to page 3 - infinite scroll was the only path onward. Same
                hidden-when-scripting treatment as home.hbs. --}}
            {{#if pagination.next}}
            <footer class="gh-topic-footer">
                <a class="gh-topic-link gh-loadmore" href="{{page_url pagination.next}}">{{t "Show more"}} {{> "icons/arrow"}}</a>
            </footer>
            {{/if}}
        </div>
        </div>
        {{> "community-sidebar"}}
    </div>
    </div>
</main>
