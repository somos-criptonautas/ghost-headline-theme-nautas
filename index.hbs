{{!< default}}
{{!-- /blog/ (and /page/2/ on): every post, newest first, loading on as the
    reader scrolls. The community sits where scrolling never pushes it away:
    the aside column from 1200px, the strip above the posts below that. --}}
<main class="gh-main gh-outer">
    <div class="gh-inner">
    <div class="gh-with-sidebar">
        <div class="gh-with-sidebar-main">
        {{^if pagination.prev}}{{> "community-related" strip=true}}{{/if}}

        <div class="gh-topic gh-topic-grid gh-topic-grid-item gh-listing">
            <div class="gh-topic-content gh-feed">
                {{#foreach posts}}
                    {{> "loop-grid" has_large_post=false}}
                {{/foreach}}
            </div>

            {{!-- Without this, a reader with no JS reaches /page/2 and has no
                way to page 3 - infinite scroll was the only path onward. Same
                hidden-when-scripting treatment as home.hbs. --}}
            {{#if pagination.next}}
            <footer class="gh-topic-footer">
                <a class="gh-topic-link gh-loadmore" href="{{page_url pagination.next}}">{{t "Show more"}} {{> "icons/arrow"}}</a>
            </footer>
            {{/if}}
        </div>
        </div>
        {{> "community-sidebar"}}
    </div>
    </div>
</main>
